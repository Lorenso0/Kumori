+        /// <summary>
+        /// Displays real lazer judgement drawables at their normal gameplay
+        /// timing for an external asset-inspection scene.
+        /// </summary>
+        public void ShowAssetPreviewJudgements(IReadOnlyList<HitResult> results, double time)
+        {
+            ClearAssetPreviewJudgements();
+            if (results.Count == 0)
+                return;
+
+            const float spacing = 112;
+            float firstX = BASE_SIZE.X / 2 - spacing * (results.Count - 1) / 2;
+            for (int index = 0; index < results.Count; index++)
+            {
+                var hitObject = new HitCircle
+                {
+                    StartTime = time,
+                    Position = new Vector2(firstX + index * spacing, BASE_SIZE.Y / 2),
+                };
+                var judgement = judgementPooler.Get(results[index], candidate =>
+                {
+                    candidate.Apply(
+                        new OsuJudgementResult(hitObject, new OsuJudgement())
+                        {
+                            Type = results[index],
+                        },
+                        null);
+                    candidate.Anchor = Anchor.TopLeft;
+                    candidate.Origin = Anchor.Centre;
+                    candidate.Position = hitObject.Position;
+                });
+                if (judgement != null)
+                    assetPreviewJudgementLayer.Add(judgement);
+            }
+        }
+
+        /// <summary>
+        /// Removes only the judgement drawables owned by the asset preview.
+        /// Normal gameplay judgements remain untouched.
+        /// </summary>
+        public void ClearAssetPreviewJudgements()
+        {
+            foreach (var judgement in assetPreviewJudgementLayer.ToArray())
+                judgement.Expire();
+            assetPreviewJudgementAboveHitObjectLayer.Clear(true);
+        }
+
