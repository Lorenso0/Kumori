{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lorenso0/Kumori-Extras/schemas/catalog-v1.schema.json",
  "title": "Kumori Extras catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedAtUtc",
    "signingKeyId",
    "packs",
    "withdrawals"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "signingKeyId": { "const": "kumori-extras-2026-01" },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pack" }
    },
    "withdrawals": {
      "type": "array",
      "items": { "$ref": "#/$defs/withdrawal" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseTag", "assetName", "sha256", "downloadBytes"],
      "properties": {
        "releaseTag": { "type": "string", "pattern": "^catalog-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+(?:-part-[0-9]{3})?$" },
        "assetName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "downloadBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "entryName": { "type": ["string", "null"], "minLength": 1 },
        "entrySha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "entryDownloadBytes": { "type": ["integer", "null"], "minimum": 1, "maximum": 268435456 },
        "expandedBytes": { "type": ["integer", "null"], "minimum": 1, "maximum": 536870912 },
        "entryCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 4096 }
      },
      "allOf": [
        {
          "if": { "required": ["entryName"], "properties": { "entryName": { "type": "string" } } },
          "then": { "required": ["entrySha256", "entryDownloadBytes"] }
        }
      ]
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId", "revision", "contentFingerprint", "displayName",
        "familyId", "area", "package"
      ],
      "properties": {
        "packId": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "supersedesFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "familyId": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "variant": { "type": ["string", "null"] },
        "sourceSkin": { "type": ["string", "null"] },
        "sourceAuthor": { "type": ["string", "null"] },
        "compatibility": { "type": ["string", "null"] },
        "minimumKumoriVersion": { "type": ["string", "null"] },
        "package": { "$ref": "#/$defs/asset" },
        "preview": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/asset" }
          ]
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId", "lastRevision", "contentFingerprint", "withdrawnAtUtc"
      ],
      "properties": {
        "packId": { "type": "string", "format": "uuid" },
        "lastRevision": { "type": "integer", "minimum": 1 },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "withdrawnAtUtc": { "type": "string", "format": "date-time" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
