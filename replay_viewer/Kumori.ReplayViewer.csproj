<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>Assets\ReplayViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- osu! 2026.621 is compiled against AutoMapper's pre-v15 public constructor ABI. -->
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <!-- Security floors for older transitive references in the osu! dependency graph. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="ppy.osu.Game" Version="2026.621.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.621.0" />
    <!--
      osu! is binary-linked to AutoMapper's pre-v15 constructor ABI. The
      recursion advisory is not reachable here: mappings and mapped Realm
      key-binding types are fixed by osu!, and Kumori accepts no mapper
      configuration or object graphs from contracts/beatmaps.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Kumori.Core\Kumori.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ReplayViewer.ico"
                      LogicalName="Kumori.ReplayViewer.replay.ico" />
    <Content Include="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
