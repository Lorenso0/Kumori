<Project>
  <PropertyGroup>
    <_KumoriAutoMapperPatcherDll>$(MSBuildThisFileDirectory)tools\Kumori.AutoMapperCompatPatcher\bin\$(Configuration)\net10.0\Kumori.AutoMapperCompatPatcher.dll</_KumoriAutoMapperPatcherDll>
    <!-- Run the patcher with the same dotnet installation that owns this SDK.
         A different system-wide host may not have the selected runtime. -->
    <_KumoriDotNetHost>$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)\..\..\..\dotnet.exe'))</_KumoriDotNetHost>
    <_KumoriIsUpstreamOsuProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/').Contains('/third_party/osu'))</_KumoriIsUpstreamOsuProject>
    <!-- A running Debug app can lock output assemblies. Keep direct builds
         responsive; build-app.cmd handles the lock by stopping only this
         checkout's processes before MSBuild starts. -->
    <CopyRetryCount Condition="'$(Configuration)' == 'Debug'">2</CopyRetryCount>
    <CopyRetryDelayMilliseconds Condition="'$(Configuration)' == 'Debug'">100</CopyRetryDelayMilliseconds>
    <!-- lazer persists assembly-qualified component names in skin layout JSON.
         Keep osu!standard on its canonical identity when Kumori passes its
         own release version as a global MSBuild property. Directory.Build.targets
         is used because the vendored osu tree owns a nearer props file. -->
    <AssemblyVersion Condition="'$(_KumoriIsUpstreamOsuProject)' == 'True' and '$(MSBuildProjectName)' == 'osu.Game.Rulesets.Osu'">1.0.0.0</AssemblyVersion>
    <GenerateAssemblyInfo Condition="'$(_KumoriIsUpstreamOsuProject)' == 'True' and '$(MSBuildProjectName)' == 'osu.Game.Rulesets.Osu'">true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    ppy.osu.Game is still binary-linked to AutoMapper's removed one-argument
    MapperConfiguration constructor. Patch only copied build/publish outputs;
    the global NuGet cache remains untouched. The patcher fails closed if the
    upstream IL changes, which forces this compatibility layer to be reviewed.
  -->
  <Target Name="BuildKumoriAutoMapperCompatPatcher"
          Inputs="$(MSBuildThisFileDirectory)tools\Kumori.AutoMapperCompatPatcher\Kumori.AutoMapperCompatPatcher.csproj;$(MSBuildThisFileDirectory)tools\Kumori.AutoMapperCompatPatcher\Program.cs"
          Outputs="$(_KumoriAutoMapperPatcherDll)"
          Condition="'$(_KumoriIsUpstreamOsuProject)' != 'True' and (Exists('$(TargetDir)osu.Game.dll') or Exists('$(PublishDir)osu.Game.dll'))">
    <!-- RID publish properties can flow through ProjectReference despite its
         metadata. Build one predictable framework-dependent tool output so a
         clean standalone app publish never relies on an earlier viewer build. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)tools\Kumori.AutoMapperCompatPatcher\Kumori.AutoMapperCompatPatcher.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PlatformTarget;TargetFramework;TargetFrameworks;PublishSingleFile;PublishReadyToRun;PublishTrimmed" />
  </Target>

  <Target Name="PatchOsuGameAutoMapperInBuildOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="BuildKumoriAutoMapperCompatPatcher"
          Condition="'$(_KumoriIsUpstreamOsuProject)' != 'True' and Exists('$(TargetDir)osu.Game.dll')">
    <Error Condition="!Exists('$(_KumoriAutoMapperPatcherDll)')"
           Text="The AutoMapper compatibility patcher was not built: $(_KumoriAutoMapperPatcherDll)" />
    <Exec Command="&quot;$(_KumoriDotNetHost)&quot; &quot;$(_KumoriAutoMapperPatcherDll)&quot; &quot;$(TargetDir)osu.Game.dll&quot;" />
  </Target>

  <Target Name="PatchOsuGameAutoMapperInPublishOutput"
          AfterTargets="CopyFilesToPublishDirectory"
          BeforeTargets="GenerateSingleFileBundle"
          DependsOnTargets="BuildKumoriAutoMapperCompatPatcher"
          Condition="'$(_KumoriIsUpstreamOsuProject)' != 'True' and Exists('$(PublishDir)osu.Game.dll')">
    <Error Condition="!Exists('$(_KumoriAutoMapperPatcherDll)')"
           Text="The AutoMapper compatibility patcher was not built: $(_KumoriAutoMapperPatcherDll)" />
    <Exec Command="&quot;$(_KumoriDotNetHost)&quot; &quot;$(_KumoriAutoMapperPatcherDll)&quot; &quot;$(PublishDir)osu.Game.dll&quot;" />
  </Target>
</Project>
