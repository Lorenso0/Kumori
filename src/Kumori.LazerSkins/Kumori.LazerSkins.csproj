<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kumori.Skins\Kumori.Skins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- This assembly uses Realm's dynamic API only. Excluding the model
         generator/weaver is essential when it is loaded inside osu!: even an
         empty late AddDefaultTypes call is rejected after osu!'s Realm opens. -->
    <PackageReference Include="Realm"
                      Version="20.1.0"
                      ExcludeAssets="analyzers;build;buildTransitive" />
  </ItemGroup>
</Project>
