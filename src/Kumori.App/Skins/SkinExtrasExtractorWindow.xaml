<Window x:Class="Kumori.App.Skins.SkinExtrasExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Skin Extras"
        Width="920"
        Height="700"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Extract to Skin Extras"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="Choose a folder of loose skin files or a full skin, review the detected families, then extract sorted reusable packs with settings and duplicate protection." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource Brush.CardBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SourceNameText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourcePathText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Library pack name"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBox x:Name="PackNameTextBox"
                                 MinWidth="280"
                                 Height="28"
                                 Padding="7,3"
                                 ToolTip="Used for every selected family; invalid filename characters are sanitized." />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open folder…"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Click="OpenFolder_Click" />
                    <Button Content="Open .osk…"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Click="OpenOsk_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DetectionSummaryText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <CheckBox x:Name="LazerUsedOnlyCheckBox"
                      Grid.Column="1"
                      Content="Lazer-used only"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      ToolTip="Only extract assets requested by osu! lazer 2026.702.0"
                      Checked="LazerFilter_Changed"
                      Unchecked="LazerFilter_Changed" />
            <Button Grid.Column="2"
                    Content="Select all"
                    Padding="9,4"
                    Click="SelectAll_Click" />
            <Button Grid.Column="3"
                    Content="Clear"
                    Margin="6,0,0,0"
                    Padding="9,4"
                    Click="Clear_Click" />
        </Grid>

        <ListBox x:Name="FamilyList"
                 Grid.Row="3"
                 BorderBrush="{DynamicResource Brush.BorderSubtle}"
                 Background="{DynamicResource Brush.CardBackground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Top"
                                      Margin="0,3,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Diagnostics}"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Padding="7,3"
                                    CornerRadius="8"
                                    Background="{DynamicResource Brush.ControlBackground}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Area}"
                                           FontSize="9"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </Grid>
                        <Expander Header="Review files"
                                  Margin="28,7,0,0"
                                  IsExpanded="False">
                            <ScrollViewer MaxHeight="130"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VisibleFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,7,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="10" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CompatibilityBadge}"
                                                           Margin="10,0,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.AccentPink}" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Size}"
                                                           Margin="10,0,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Padding="16,7"
                    IsCancel="True" />
            <Button x:Name="ExtractButton"
                    Grid.Column="2"
                    Content="Extract selected"
                    Margin="8,0,0,0"
                    Padding="16,7"
                    IsDefault="True"
                    Click="Extract_Click" />
        </Grid>
    </Grid>
</Window>
