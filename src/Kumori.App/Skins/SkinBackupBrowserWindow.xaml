<Window x:Class="Kumori.App.Skins.SkinBackupBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Restore Skin Elements"
        Width="940"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Restore previous elements"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="Choose a backup, review its files, then add only the checked versions to Changes." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="10"
                    Background="{DynamicResource Brush.CardBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="5,2,5,9"
                               Text="BACKUPS"
                               Style="{StaticResource Text.LabelUpper}" />
                    <ListBox x:Name="BackupList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="BackupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,7">
                                    <TextBlock Text="{Binding CreatedText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SummaryText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding KindText}"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource Brush.CardBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FILES IN THIS BACKUP"
                                       Style="{StaticResource Text.LabelUpper}" />
                            <TextBlock x:Name="BackupDetailsText"
                                       Margin="0,4,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Select all"
                                Padding="9,4"
                                Click="SelectAll_Click" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Margin="6,0,0,0"
                                Padding="9,4"
                                Click="Clear_Click" />
                    </Grid>
                    <ListBox x:Name="BackupFilesList"
                             Grid.Row="1"
                             Background="{DynamicResource Brush.PanelBackground}"
                             BorderBrush="{DynamicResource Brush.BorderSubtle}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Padding="8,7"
                                          Click="FileChoice_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="30"
                                                Background="{DynamicResource Brush.ControlBackground}"
                                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding ExtensionText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentPink}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Filename}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding GroupText}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SizeText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    MinWidth="92"
                    Height="34"
                    Padding="12,0"
                    IsCancel="True" />
            <Button x:Name="RestoreButton"
                    Grid.Column="2"
                    Content="Add selected to Changes"
                    MinWidth="178"
                    Height="34"
                    Margin="8,0,0,0"
                    Padding="14,0"
                    Style="{StaticResource Button.Primary}"
                    IsDefault="True"
                    Click="Restore_Click" />
        </Grid>
    </Grid>
</Window>
