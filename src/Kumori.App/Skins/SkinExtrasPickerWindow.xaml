                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="250" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Margin="0"
                            MaxHeight="470"
                            HorizontalAlignment="Stretch"
