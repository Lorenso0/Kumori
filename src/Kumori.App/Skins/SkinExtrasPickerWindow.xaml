                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                             <Border Grid.Column="0"
                                                     Padding="10"
                                                    Background="{DynamicResource Brush.ControlBackground}"
                                                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
