                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel HorizontalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                        </ListBox>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                             <Border Grid.Column="2"
                                                     Padding="10"
