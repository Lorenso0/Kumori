<UserControl x:Class="Kumori.App.Skins.SkinExtrasPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kumori.App"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        PreviewKeyDown="ExtrasPicker_PreviewKeyDown"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="ExtrasBackButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="156" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource Brush.AccentPink}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.StrongBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewModeToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.ControlHoverBackground}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.CardSelectedBackground}" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.AccentPink}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.AccentPink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VirtualizedExtrasItems" TargetType="ItemsControl">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="2" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PackFileChoiceTemplate">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsSelectable}"
                      Margin="0,1"
                      Padding="3,2"
                      ToolTip="{Binding PreviewToolTip}"
                      Click="PackFileChoice_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayKind}"
                               Width="56"
                               FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CompatibilityBadge}"
                               Margin="10,0,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource Brush.AccentPink}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding Size}"
                               Margin="10,0,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                </Grid>
            </CheckBox>
        </DataTemplate>
        <DataTemplate x:Key="PackElementChoiceTemplate">
            <Border Margin="0,2"
                    Padding="5"
                    Background="{DynamicResource Brush.ControlBackground}"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsThreeState="True"
                                  VerticalAlignment="Center"
                                  Click="PackElementChoice_Click" />
                        <Border Grid.Column="1"
                                Width="30"
                                Height="30"
                                Margin="5,0"
                                Background="#FF000000"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                        </Border>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FileCountText}"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding UsageBadge}"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Success}" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="7,0"
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="{Binding CanTint}"
                                Click="ElementTintButton_Click"
                                ToolTip="Recolour this element before adding it to Changes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding TintBrush}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TintLabel}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="4"
                                Content="Only"
                                Margin="6,0,0,0"
                                Padding="7,2"
                                Tag="{Binding}"
                                Click="SelectOnlyElement_Click"
                                ToolTip="Select only this logical element" />
                    </Grid>
                    <Expander Grid.Row="1"
                              Header="Physical files"
                              Margin="23,4,0,0">
                        <ItemsControl ItemsSource="{Binding Files}"
                                      ItemTemplate="{StaticResource PackFileChoiceTemplate}" />
                    </Expander>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PackSettingChoiceTemplate">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      IsEnabled="{Binding IsEditable}"
                      Margin="0,2"
                      Padding="3,2"
                      ToolTip="{Binding ChangeText}"
                      Click="PackSettingChoice_Click">
                <TextBlock Text="{Binding Key}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </CheckBox>
        </DataTemplate>
        <DrawingBrush x:Key="TransparencyGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Brush.CardBackground}"
                                     Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource Brush.ControlBackground}"
                                     Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource Brush.AppBackground}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.TopBarBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="8,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource ExtrasBackButton}"
                            Content="&#x2190;  Back to Skin Studio"
                            Click="CloseWindow_Click"
                            ToolTip="Return to Skin Studio (Esc or Alt+Left)"
                            AutomationProperties.Name="Back to Skin Studio"
                            AutomationProperties.HelpText="Close Extras and return to the Skin Studio workspace" />
                    <Border Grid.Column="1"
                            Width="1"
                            Height="20"
                            Margin="12,0"
                            Background="{DynamicResource Brush.BorderSubtle}" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Extras Library"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            Padding="7,3"
                            Background="{DynamicResource Brush.ControlBackground}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock Text="Esc"
                                   FontSize="9"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText"
                               Text="Browse Skin Extras"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <Border Margin="10,2,0,0"
                            Padding="7,2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.ControlBackground}"
                            CornerRadius="9">
                        <TextBlock x:Name="HeaderPackCountText"
                                   Text="0 packs"
                                   FontSize="9"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ExtrasSyncStatusText"
                           Margin="0,3,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Brush.AccentPink}"
                           Text="Extras catalog has not been checked yet."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Column="1" Height="32" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox"
                         Padding="28,5,9,5"
                         ToolTip="Search names, authors, families, filenames, or tags"
                         AutomationProperties.Name="Search packs"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Search packs">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RandomHitsoundsButton"
                        Content="3 random sounds"
                        Height="32"
                        Margin="10,0,0,0"
                        Padding="10,0"
                        Click="RandomHitsounds_Click"
                        ToolTip="Pick one fresh Normal, Soft, and Drum hitsound pack" />
                <Button x:Name="FullRandomButton"
                        Content="Full random"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        Click="FullRandom_Click"
                        ToolTip="Pick one fresh compatible pack for every family" />
                <Button x:Name="CheckExtrasUpdatesButton"
                        Content="Check for updates"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        VerticalAlignment="Top"
                        Click="CheckExtrasUpdates_Click"
                        ToolTip="Check GitHub and synchronize the complete Extras catalog"
                        AutomationProperties.Name="Check Extras for updates" />
            </StackPanel>
            <CheckBox x:Name="LazerUsedOnlyCheckBox"
                      Grid.Column="3"
                      Content="Lazer used"
                      Margin="12,7,0,0"
                      VerticalAlignment="Top"
                      ToolTip="Show only assets requested by osu! lazer 2026.702.0"
                      Checked="LazerFilter_Changed"
                      Unchecked="LazerFilter_Changed" />
            <CheckBox x:Name="FavoritesOnlyCheckBox"
                      Grid.Column="4"
                      Content="Favorites"
                      Margin="12,7,0,0"
                      VerticalAlignment="Top"
                      Checked="LibraryFilter_Changed"
                      Unchecked="LibraryFilter_Changed" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.ThemeCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="FAMILIES"
                               Style="{StaticResource Text.LabelUpper}"
                               Margin="12,10,12,8" />
                <ListBox x:Name="FamilyList"
                             Grid.Row="1"
                             Margin="7,0,7,7"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             SelectionChanged="FamilyList_SelectionChanged">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              PreviewMouseWheel="LibraryList_PreviewMouseWheel">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="8,10,6,4"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.AccentPink}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="34" Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            MinWidth="22"
                                            Padding="5,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource Brush.ControlBackground}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PackCount}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.ThemeCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PACKS"
                               Style="{StaticResource Text.LabelUpper}"
                               Margin="12,10,12,8" />
                    <ItemsControl x:Name="PackList"
                                  Grid.Row="1"
                                  Margin="7,0,7,7"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="2"
                                  VirtualizingPanel.CacheLengthUnit="Page">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              PreviewMouseWheel="LibraryList_PreviewMouseWheel">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,8,4,4"
                                                Padding="6,4"
                                                Background="{DynamicResource Brush.ControlBackground}"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentPink}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2"
                                        Padding="4"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Brush.CardHoverBackground}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.BorderSubtle}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Brush.CardSelectedBackground}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.BorderStrong}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid MinHeight="66"
                                              PreviewMouseLeftButtonDown="PackRow_PreviewMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="PackExpandToggle"
                                                      Width="26"
                                                      Height="46"
                                                      Padding="0"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Checked="PackExpander_Expanded"
                                                      Unchecked="PackExpander_Collapsed"
                                                      ToolTip="Expand or collapse files">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="ToggleChrome"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ToggleChrome"
                                                                    Property="Background"
                                                                    Value="{DynamicResource Brush.ControlHoverBackground}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <Path Width="10"
                                                  Height="6"
                                                  Data="M 1,1 L 5,5 L 9,1"
                                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0" />
