                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel HorizontalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                        </ListBox>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
