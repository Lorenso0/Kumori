                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedPackHealthText"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.Success}"
