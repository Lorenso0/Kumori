                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="WITH SELECTION"
                                                               Style="{StaticResource Text.LabelUpper}"
                                                               HorizontalAlignment="Center" />
