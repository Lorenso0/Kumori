                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="CURRENT SKIN"
                                                               Style="{StaticResource Text.LabelUpper}"
                                                               HorizontalAlignment="Center" />
