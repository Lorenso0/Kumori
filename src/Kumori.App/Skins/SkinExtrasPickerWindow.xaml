                                    <Canvas x:Name="CursorTrailCanvas"
                                            Width="380"
                                            Height="210"
                                            ClipToBounds="False" />
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="PreviewCaption"
                                       Grid.Row="2"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,7"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Border>

                    <Border x:Name="IncludedElementsCard"
                            Grid.Row="2"
                            Padding="10"
                            Background="{DynamicResource Brush.ControlBackground}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Expander x:Name="PackFilesExpander"
                                  Header="Included elements"
                                  IsExpanded="True"
                                  Expanded="PackFilesExpander_Expanded">
                            <Grid Margin="0,7,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,6">
                                    <Button Content="All"
                                            Padding="7,2"
                                            Click="SelectAllPackFiles_Click" />
                                    <Button Content="None"
                                            Margin="5,0,0,0"
                                            Padding="7,2"
                                            Click="SelectNoPackFiles_Click" />
                                    <Button Content="Invert"
                                            Margin="5,0,0,0"
                                            Padding="7,2"
                                            Click="InvertPackFiles_Click" />
                                </StackPanel>
                                <ItemsControl x:Name="PackFilesList"
                                              Grid.Row="1"
                                              MaxHeight="210"
                                              Style="{StaticResource VirtualizedExtrasItems}"
                                              ItemTemplate="{StaticResource PackElementChoiceTemplate}" />
                            </Grid>
                        </Expander>
                    </Border>
                        </Grid>

                    <Border x:Name="PackDetailsInspector"
                            Grid.Column="2"
                            Background="{DynamicResource Brush.ControlBackground}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8">
                    <ScrollViewer
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly">
                    <StackPanel Margin="14">
                        <Border x:Name="PackNoticePanel"
                                Margin="0,0,0,8"
                                Padding="9,7"
                                Background="{DynamicResource Brush.PanelBackground}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PackDetails"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="ResolutionMismatchPanel"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Brush.ControlBackground}"
                                BorderBrush="{DynamicResource Brush.AccentPink}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="RESOLUTION MATCH"
                                           Style="{StaticResource Text.LabelUpper}" />
                                <TextBlock x:Name="ResolutionMismatchText"
                                           Margin="0,3,0,7"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" />
                                <RadioButton x:Name="UpscaleResolutionOption"
                                             GroupName="ExtrasResolutionPolicy"
                                             IsChecked="True"
                                             Content="Create matching @2x (recommended)"
                                             ToolTip="High-quality 2× upscale that replaces the current @2x file." />
                                <RadioButton x:Name="UseOneXResolutionOption"
                                             GroupName="ExtrasResolutionPolicy"
                                             Margin="0,5,0,0"
                                             Content="Use the pack's 1× file"
                                             ToolTip="Removes the current @2x file so osu! uses the selected 1× file." />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CursorOptionsPanel"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Brush.ControlBackground}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CURSOR TRAIL"
                                           Style="{StaticResource Text.LabelUpper}" />
                                <CheckBox x:Name="SmoothTrailCheckBox"
                                          Margin="0,5,0,0"
                                          Content="Smooth Trail"
                                          Checked="SmoothTrail_Changed"
                                          Unchecked="SmoothTrail_Changed"
                                          ToolTip="Adds a transparent 1×1 cursormiddle.png placeholder." />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="RenamePackButton"
                                    Content="Rename…"
                                    Padding="9,3"
                                    Click="RenamePack_Click" />
                            <Button
                                    Content="Delete…"
                                    Margin="6,0,0,0"
                                    Padding="9,3"
                                    Style="{StaticResource Button.Danger}"
                                    Click="DeletePack_Click" />
                        </StackPanel>
                        <Expander x:Name="PackSettingsExpander"
                                  Header="Settings"
                                  Margin="0,7,0,0"
                                  Visibility="Collapsed">
                            <Border Margin="0,5,0,0"
                                    Padding="8,5"
                                    Background="{DynamicResource Brush.ControlBackground}"
                                    CornerRadius="5">
                                <ItemsControl x:Name="PackSettingsList"
                                              MaxHeight="132"
                                              Style="{StaticResource VirtualizedExtrasItems}"
                                              ItemTemplate="{StaticResource PackSettingChoiceTemplate}" />
                            </Border>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="UtilityBar" Grid.Row="4">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Content="Open folder"
                        Click="OpenFolder_Click" />
                <Button Content="Import file…"
                        Margin="8,0,0,0"
                        Click="ImportPackage_Click" />
                <Button Content="Import skin folder..."
                        Margin="8,0,0,0"
                        Click="ImportFolder_Click" />
                <Button Content="Export…"
                        Margin="8,0,0,0"
                        Click="ExportPackage_Click" />
                <Button Content="Check &amp; repair"
                        Margin="8,0,0,0"
                        Click="ValidateRepair_Click" />
            </StackPanel>
        </Grid>
            </Grid>

            <Grid x:Name="RandomMixOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="101"
                  Background="#E8100D12"
                  Visibility="Collapsed"
                  Focusable="True"
                  AutomationProperties.Name="Random skin mix in progress"
                  AutomationProperties.LiveSetting="Polite">
                <Border Width="520"
                        MaxWidth="520"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.PanelBackground}"
                        BorderBrush="{DynamicResource Brush.AccentPink}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="BUILDING RANDOM MIX"
                                   Style="{StaticResource Text.LabelUpper}"
                                   Foreground="{DynamicResource Brush.AccentPink}" />
                        <TextBlock x:Name="RandomMixOverlayText"
                                   Margin="0,9,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="RandomMixProgressBar"
                                     Height="9"
                                     Margin="0,14,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     IsIndeterminate="False" />
                        <TextBlock x:Name="RandomMixProgressDetailText"
                                   Margin="0,7,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="Each selected family is staged as a reversible action in Changes."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CatalogSyncOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="100"
                  Background="#E8100D12"
                  Visibility="Collapsed"
                  Focusable="True"
                  AutomationProperties.Name="Extras synchronization in progress"
                  AutomationProperties.LiveSetting="Polite">
                <Border Width="520"
                        MaxWidth="520"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.PanelBackground}"
                        BorderBrush="{DynamicResource Brush.AccentPink}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="UPDATING EXTRAS"
                                   Style="{StaticResource Text.LabelUpper}"
                                   Foreground="{DynamicResource Brush.AccentPink}" />
                        <TextBlock x:Name="CatalogSyncOverlayText"
                                   Margin="0,9,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="CatalogSyncProgressBar"
                                     Height="9"
                                     Margin="0,14,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="True" />
                        <TextBlock x:Name="CatalogSyncProgressDetailText"
                                   Margin="0,7,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="The Extras library will refresh automatically when this finishes."
                                   TextWrapping="Wrap" />
                        <Button x:Name="CancelCatalogSyncButton"
                                Margin="0,16,0,0"
                                Padding="14,5"
                                HorizontalAlignment="Right"
                                Content="Cancel download"
                                Style="{StaticResource Button.Danger}"
                                Click="CancelCatalogSync_Click"
                                AutomationProperties.Name="Cancel Extras download" />
                    </StackPanel>
                </Border>
            </Grid>
            <Popup x:Name="ElementColorPickerPopup"
                   Placement="Right"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   HorizontalOffset="6">
                <local:CustomThemeColorPicker x:Name="ElementColorPicker" />
            </Popup>
        </Grid>
    </Border>
</UserControl>
