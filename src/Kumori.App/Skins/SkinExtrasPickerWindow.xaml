                                </Border>
                                <Border x:Name="SelectedPackCompletenessBadge"
                                        Margin="6,0,0,0"
                                        Padding="7,2"
                                        Background="{DynamicResource Brush.ControlBackground}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedPackCompletenessText"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </Border>
                                <Border x:Name="SelectedPackUsageBadge"
                                        Margin="6,0,0,0"
                                        Padding="7,2"
                                        Background="{DynamicResource Brush.ControlBackground}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedPackUsageText"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.Success}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SelectedPackPath"
