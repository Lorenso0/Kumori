<UserControl x:Class="Kumori.App.Skins.SkinEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kumori.App"
             xmlns:skins="clr-namespace:Kumori.App.Skins"
             MinWidth="0"
             MinHeight="0"
             Background="{DynamicResource Brush.AppBackground}">
    <UserControl.Resources>
        <Style x:Key="SkinPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SkinLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SkinAction" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SkinTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SkinTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SkinTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{TemplateBinding Background}">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.PanelBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Skin Editor"
                               FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="23"
                               LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="RootPathText"
                               Text="Open the editor to discover osu!lazer"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="10"
                               LineHeight="15"
                               LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CompactSkinPicker"
                              Width="210"
                              Margin="0,0,8,0"
                              Visibility="Collapsed"
                              SelectionChanged="CompactSkinPicker_SelectionChanged"
                              AutomationProperties.Name="Selected lazer skin">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ChangeFolderButton" Content="Change folder" Style="{StaticResource SkinAction}" Click="ChangeFolder_Click" />
                    <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SkinAction}" Click="Refresh_Click" />
                    <Button x:Name="BackupButton" Content="Backup now" Style="{StaticResource SkinAction}" Click="Backup_Click" />
                    <Button x:Name="CompactActionsButton"
                            Content="⋯"
                            Width="32"
                            Style="{StaticResource SkinAction}"
                            Visibility="Collapsed"
                            Click="CompactActions_Click"
                            AutomationProperties.Name="Skin editor actions">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Change lazer folder…" Click="ChangeFolder_Click" />
                                <MenuItem Header="Refresh" Click="Refresh_Click" />
                                <MenuItem Header="Backup now" Click="Backup_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SaveAllButton"
                            Content="Save all"
                            Style="{StaticResource Button.Primary}"
                            Height="30"
                            Padding="12,0"
                            IsEnabled="False"
                            Click="SaveAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorGrid" Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SkinListColumn" Width="230" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="InspectorColumn" Width="310" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SkinListPanel" Grid.Column="0" Style="{StaticResource SkinPanel}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LAZER SKINS" Style="{StaticResource SkinLabel}" Margin="2,0,0,7" />
                    <TextBox x:Name="SkinSearchBox"
                             DockPanel.Dock="Top"
                             Height="30"
                             Margin="0,0,0,8"
                             TextChanged="SkinSearchBox_TextChanged"
                             AutomationProperties.Name="Search lazer skins" />
                    <ListBox x:Name="SkinList"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="SkinList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Lazer skins" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="GameplayRow" Height="320" MinHeight="220" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SkinPanel}">
                    <TabControl x:Name="WorkspaceTabs"
                                Style="{StaticResource SkinTabControl}"
                                SelectionChanged="WorkspaceTabs_SelectionChanged">
                        <TabItem Header="Elements">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CategoryPicker"
                                              MinWidth="180"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="CategoryPicker_SelectionChanged"
                                              AutomationProperties.Name="Element category">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayLabel}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <CheckBox x:Name="HideEmptyElementsToggle"
                                                  Content="Hide empty"
                                                  Margin="8,0,10,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Hide fully transparent placeholder images"
                                                  Checked="HideEmptyElements_Changed"
                                                  Unchecked="HideEmptyElements_Changed"
                                                  AutomationProperties.Name="Hide empty skin elements" />
                                        <Button Content="Import files…"
                                                Style="{StaticResource SkinAction}"
                                                Margin="0"
                                                Click="ImportFiles_Click" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ElementList"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         SelectionMode="Extended"
                                         AllowDrop="True"
                                         SelectionChanged="ElementList_SelectionChanged"
                                         KeyDown="ElementList_KeyDown"
                                         DragOver="ElementList_DragOver"
                                         Drop="ElementList_Drop"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Skin elements">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy element(s)" InputGestureText="Ctrl+C" Click="CopyElements_Click" />
                                            <MenuItem Header="Paste element(s)" InputGestureText="Ctrl+V" Click="PasteElements_Click" />
                                            <Separator />
                                            <MenuItem Header="Import files…" Click="ImportFiles_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type skins:SkinElementEntry}">
                                            <StackPanel Width="118" Margin="5">
                                                <Border Height="86"
                                                        Background="{DynamicResource Brush.CardBackground}"
                                                        BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}"
                                                               Margin="5"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="♫"
                                                                   FontSize="26"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Filename}"
                                                           ToolTip="{Binding Filename}"
                                                           FontSize="10"
                                                           Margin="1,4,1,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ResolutionVariantLabel}"
                                                           ToolTip="Both the normal and @2x files are present; edits apply to both"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           FontSize="9"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPairedResolution}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding EditState}"
                                                           Foreground="{DynamicResource Brush.AccentPink}"
                                                           FontSize="9" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="skin.ini">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="ComboStrip" Orientation="Horizontal" />
                                    <Button x:Name="SaveIniButton"
                                            Grid.Column="1"
                                            Content="Save skin.ini"
                                            Style="{StaticResource Button.Primary}"
                                            Height="30"
                                            Padding="12,0"
                                            IsEnabled="False"
                                            Click="SaveIni_Click" />
                                </Grid>
                                <TabControl x:Name="IniModeTabs"
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource SkinTabControl}"
                                            BorderThickness="1"
                                            SelectionChanged="IniModeTabs_SelectionChanged">
                                    <TabItem Header="Form">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="IniFormPanel" Margin="4" />
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Raw">
                                        <TextBox x:Name="RawIniText"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="RawIniText_TextChanged"
                                                 AutomationProperties.Name="Raw skin.ini editor" />
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="CompactEditorTab" Header="Editor" Visibility="Collapsed">
                            <ContentControl x:Name="CompactInspectorHost"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource Brush.SubtleBorder}" />

                <Border Grid.Row="2" Style="{StaticResource SkinPanel}" ClipToBounds="True">
                    <DockPanel x:Name="GameplayCanvas" Background="#FF09090D">
                        <Grid DockPanel.Dock="Top" Height="32" Margin="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GAMEPLAY PREVIEW"
                                           Style="{StaticResource SkinLabel}"
                                           Foreground="{DynamicResource Brush.AccentPink}" />
                                <TextBlock x:Name="GameplaySkinName"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="SkinBackgroundToggle"
                                         Content="Skin bg"
                                         GroupName="GameplayBackground"
                                         IsChecked="True"
                                         Checked="GameplayBackground_Checked" />
                            <RadioButton Content="Black bg"
                                         GroupName="GameplayBackground"
                                         Margin="10,0,0,0"
                                         Checked="GameplayBackground_Checked" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="8,0,8,8" ClipToBounds="True" Background="#FF0E0F18">
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="880" Height="505" Background="#FF0E0F18">
                                    <Image x:Name="GameplayBackground"
                                           Width="880"
                                           Height="505"
                                           Stretch="UniformToFill"
                                           Opacity="0.3" />
                                    <Rectangle Width="880" Height="505" Fill="#7A000000" />

                                    <Image x:Name="GameplaySliderBody"
                                           Width="880"
                                           Height="505"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <Image x:Name="GameplayTailCircle" Width="100" Height="100" Canvas.Left="620" Canvas.Top="130" />
                                    <Image x:Name="GameplayTailOverlay" Width="100" Height="100" Canvas.Left="620" Canvas.Top="130" />
                                    <Image x:Name="GameplayReverseArrow" Width="100" Height="100" Canvas.Left="620" Canvas.Top="130" />

                                    <Image x:Name="GameplayFollowCircle" Width="150" Height="150" Canvas.Left="365" Canvas.Top="145" />
                                    <Image x:Name="GameplaySliderBall" Width="100" Height="100" Canvas.Left="390" Canvas.Top="170" />

                                    <Image x:Name="GameplayApproach" Width="150" Height="150" Canvas.Left="115" Canvas.Top="235" />
                                    <Image x:Name="GameplayHitcircle" Width="100" Height="100" Canvas.Left="140" Canvas.Top="260" />
                                    <Image x:Name="GameplayOverlay" Width="100" Height="100" Canvas.Left="140" Canvas.Top="260" />
                                    <Image x:Name="GameplayNumber" Width="34" Height="44" Canvas.Left="173" Canvas.Top="288" />

                                    <Image x:Name="GameplayScorebar" Width="230" Height="36" Canvas.Left="14" Canvas.Top="12" Stretch="Fill" />
                                    <Image x:Name="GameplayScorebarMarker" Width="36" Height="36" Canvas.Left="222" Canvas.Top="12" />
                                    <TextBlock Text="08,472,190"
                                               Canvas.Right="18"
                                               Canvas.Top="10"
                                               FontSize="26"
                                               FontFamily="Consolas"
                                               Foreground="#FFF0F0F5" />
                                    <TextBlock Text="342x"
                                               Canvas.Left="18"
                                               Canvas.Bottom="12"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#FFF0F0F5" />

                                    <Image x:Name="GameplayCursorTrail"
                                           Width="64"
                                           Height="64"
                                           Canvas.Left="480"
                                           Canvas.Top="330"
                                           Opacity="0.65" />
                                    <Image x:Name="GameplayCursor"
                                           Width="72"
                                           Height="72"
                                           Canvas.Left="500"
                                           Canvas.Top="315" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="InspectorPanel" Grid.Column="4" Style="{StaticResource SkinPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ELEMENT EDITOR" Style="{StaticResource SkinLabel}" />
                        <Border Height="180"
                                Margin="0,9,0,0"
                                Background="{DynamicResource Brush.CardBackground}"
                                BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Image x:Name="ElementPreview"
                                       Margin="9"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="ElementPreviewHint"
                                           Text="Select an image element"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SelectedElementName"
                                   Margin="0,7,0,0"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedElementMeta"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="10" />

                        <StackPanel x:Name="ImageEditorControls" IsEnabled="False">
                            <TextBlock Text="RECOLOUR MODE" Style="{StaticResource SkinLabel}" Margin="0,14,0,5" />
                            <ComboBox x:Name="RecolorModePicker"
                                      SelectionChanged="RecolorModePicker_SelectionChanged">
                                <ComboBoxItem Content="Colorize" Tag="Colorize" />
                                <ComboBoxItem Content="Tint" Tag="Tint" />
                                <ComboBoxItem Content="Hue / Saturation" Tag="HueSaturation" />
                            </ComboBox>

                            <StackPanel x:Name="TargetColorPanel">
                                <TextBlock Text="TARGET COLOUR" Style="{StaticResource SkinLabel}" Margin="0,12,0,5" />
                                <DockPanel>
                                    <Border x:Name="CurrentColorSwatch"
                                            Width="36"
                                            Height="28"
                                            BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Background="White"
                                            DockPanel.Dock="Left" />
                                    <Button Content="Pick…"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource SkinAction}"
                                            Margin="6,0,0,0"
                                            Click="PickColor_Click" />
                                    <TextBox x:Name="HexColorBox"
                                             Margin="7,0,0,0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="HexColorBox_TextChanged" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,3">
                                    <Button Content="+ Save colour"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource SkinAction}"
                                            Margin="0"
                                            Click="SaveSwatch_Click" />
                                    <TextBlock Text="SWATCHES" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel x:Name="SwatchPanel" />
                            </StackPanel>

                            <StackPanel x:Name="HueShiftPanel" Visibility="Collapsed">
                                <TextBlock Text="Hue shift" Style="{StaticResource SkinLabel}" Margin="0,12,0,0" />
                                <Slider x:Name="HueShiftSlider" Minimum="-180" Maximum="180" ValueChanged="HueShift_Changed" />
                                <TextBlock Text="Saturation" Style="{StaticResource SkinLabel}" />
                                <Slider x:Name="SaturationShiftSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="HueShift_Changed" />
                                <TextBlock Text="Lightness" Style="{StaticResource SkinLabel}" />
                                <Slider x:Name="LightnessShiftSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="HueShift_Changed" />
                            </StackPanel>

                            <Button x:Name="SaveElementButton"
                                    Content="Save to skin"
                                    Style="{StaticResource Button.Primary}"
                                    Height="32"
                                    Margin="0,14,0,0"
                                    Click="SaveElement_Click" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ResetElementButton" Content="Reset" Grid.Column="0" Style="{StaticResource SkinAction}" Margin="0" Click="ResetElement_Click" />
                                <Button x:Name="ExportElementButton" Content="Export PNG" Grid.Column="2" Style="{StaticResource SkinAction}" Margin="0" Click="ExportElement_Click" />
                            </Grid>
                            <Button x:Name="OpenExternallyButton"
                                    Content="Open externally (auto-sync)"
                                    Style="{StaticResource SkinAction}"
                                    Margin="0,7,0,0"
                                    Click="OpenExternally_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.PanelBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock x:Name="StatusText"
                       Text="Ready."
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Border x:Name="BusyInputShield"
                Grid.RowSpan="3"
                Panel.ZIndex="900"
                Background="#01000000"
                Focusable="True"
                Visibility="Collapsed"
                AutomationProperties.Name="Skin editor busy" />

        <Popup x:Name="SkinColorPickerPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               HorizontalOffset="-150"
               VerticalOffset="5">
            <local:CustomThemeColorPicker x:Name="IntegratedSkinColorPicker" />
        </Popup>
    </Grid>
</UserControl>
