                                            SelectionChanged="IniModeTabs_SelectionChanged">
                                    <TabItem Header="Form">
                                        <ScrollViewer x:Name="IniFormScroll"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="IniFormPanel" Margin="12" />
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Raw">
                                        <TextBox x:Name="RawIniText"
                                                 Margin="12"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="RawIniText_TextChanged"
                                                 AutomationProperties.Name="Raw skin.ini editor" />
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border x:Name="InspectorPanel"
                        Grid.Column="4"
                        Style="{StaticResource SkinPanel}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="InspectorTitleText"
                                               Text="Properties"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="InspectorSubtitleText"
                                               Text="Select an element to edit it."
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="ReviewCloseButton"
                                        HorizontalAlignment="Right"
                                        Content="Back"
                                        Style="{StaticResource SkinAction}"
                                        Click="ReviewClose_Click"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid x:Name="ContextInspectorContent" Grid.Row="1">
                            <Grid x:Name="ElementInspectorContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="12,10,12,4">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedElementName"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SelectedElementMeta"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="SelectedElementUsage"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                        <Border x:Name="SelectedElementEffectiveBadge"
                                                Margin="0,8,0,0"
                                                Padding="8,6"
                                                Background="{DynamicResource Brush.ControlBackground}"
                                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock x:Name="SelectedElementEffectiveLabel"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Success}" />
                                                <TextBlock x:Name="SelectedElementEffectiveDetail"
                                                           Margin="0,2,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="OpenElementIniLinkButton"
                                                Content="Open related skin.ini settings"
                                                Style="{StaticResource SkinAction}"
                                                HorizontalAlignment="Left"
                                                Margin="0,9,0,0"
                                                Click="OpenElementIniLink_Click"
                                                Visibility="Collapsed" />

                                        <StackPanel x:Name="GameplayLocalPreviewPanel"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                            <Grid Margin="0,0,0,5">
                                                <TextBlock Text="CURRENT ASSET"
                                                           Style="{StaticResource SkinLabel}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Live local edits"
                                                           HorizontalAlignment="Right"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Grid>
                                            <Border Height="128"
                                                    Background="{StaticResource TransparencyGridBrush}"
                                                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="8">
                                                <Image x:Name="GameplayLocalAssetPreview"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="ImageEditorControls"
                                                    Margin="0,10,0,0"
                                                    IsEnabled="False">
                                            <TextBlock Text="RECOLOUR MODE" Style="{StaticResource SkinLabel}" Margin="0,4,0,5" />
                                            <ComboBox x:Name="RecolorModePicker"
                                                      SelectionChanged="RecolorModePicker_SelectionChanged">
                                                <ComboBoxItem Content="Colorize" Tag="Colorize" />
                                                <ComboBoxItem Content="Tint" Tag="Tint" />
                                                <ComboBoxItem Content="Hue / Saturation" Tag="HueSaturation" />
                                            </ComboBox>
                                            <TextBlock Text="EDIT SCOPE" Style="{StaticResource SkinLabel}" Margin="0,12,0,5" />
                                            <ComboBox x:Name="EditScopePicker" SelectedIndex="0">
                                                <ComboBoxItem Content="Current element" />
                                                <ComboBoxItem Content="Selected image elements" />
                                            </ComboBox>

                                            <StackPanel x:Name="TargetColorPanel">
                                                <TextBlock Text="TARGET COLOUR" Style="{StaticResource SkinLabel}" Margin="0,12,0,5" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="CurrentColorSwatch"
                                                            Width="36"
                                                            Height="30"
                                                            BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Background="White" />
                                                    <TextBox x:Name="HexColorBox"
                                                             Grid.Column="2"
                                                             VerticalContentAlignment="Center"
                                                             TextChanged="HexColorBox_TextChanged" />
                                                    <Button Grid.Column="4"
                                                            Content="Pick…"
                                                            Style="{StaticResource SkinAction}"
                                                            Click="PickColor_Click" />
                                                    <Button Grid.Column="6"
                                                            Content="Random"
                                                            Style="{StaticResource SkinAction}"
                                                            ToolTip="Choose a random colour"
                                                            Click="RandomElementColor_Click" />
                                                </Grid>
                                                <Grid Margin="0,10,0,4">
                                                    <TextBlock Text="SWATCHES"
                                                               Style="{StaticResource SkinLabel}"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="+ Save"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource SkinAction}"
                                                            Click="SaveSwatch_Click" />
                                                </Grid>
                                                <WrapPanel x:Name="SwatchPanel" />
                                            </StackPanel>

                                            <StackPanel x:Name="HueShiftPanel" Visibility="Collapsed">
                                                <TextBlock Text="HUE SHIFT" Style="{StaticResource SkinLabel}" Margin="0,12,0,0" />
                                                <Slider x:Name="HueShiftSlider" Minimum="-180" Maximum="180" ValueChanged="HueShift_Changed" />
                                                <TextBlock Text="SATURATION" Style="{StaticResource SkinLabel}" />
                                                <Slider x:Name="SaturationShiftSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="HueShift_Changed" />
                                                <TextBlock Text="LIGHTNESS" Style="{StaticResource SkinLabel}" />
                                                <Slider x:Name="LightnessShiftSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="HueShift_Changed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border x:Name="ElementActionFooter"
                                        Grid.Row="1"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <StackPanel>
                                        <Button x:Name="SaveElementButton"
                                                Content="Add to changes"
                                                Style="{StaticResource Button.Primary}"
                                                Height="32"
                                                Click="SaveElement_Click" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ResetElementButton"
                                                    Content="Reset"
                                                    Grid.Column="0"
                                                    Style="{StaticResource SkinAction}"
                                                    Click="ResetElement_Click" />
                                            <Button x:Name="ExportElementButton"
                                                    Content="Export PNG"
                                                    Grid.Column="2"
                                                    Style="{StaticResource SkinAction}"
                                                    Click="ExportElement_Click" />
                                        </Grid>
                                        <Button x:Name="OpenExternallyButton"
                                                Content="Open externally (stage on save)"
                                                Style="{StaticResource SkinAction}"
                                                Margin="0,7,0,0"
                                                Click="OpenExternally_Click" />
                                        <Button x:Name="DeleteElementButton"
                                                Content="Delete element…"
                                                Style="{StaticResource SkinAction}"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Margin="0,7,0,0"
                                                ToolTip="Stage deletion of this element and its paired resolution files"
                                                Click="DeleteElement_Click" />
                                        <Button x:Name="MakeTransparentButton"
                                                Content="Make transparent…"
                                                Style="{StaticResource SkinAction}"
                                                Margin="0,7,0,0"
                                                ToolTip="Keep this image file present but replace all pixels with transparency"
                                                Click="MakeTransparentButton_Click" />
                                        <TextBlock x:Name="ElementBackupHint"
                                                   Text="Original files are backed up automatically before staging."
                                                   Margin="2,7,2,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="NoElementInspectorHint"
                                            Grid.RowSpan="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="20">
                                    <TextBlock Text="Select an asset"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Its properties and editing tools will appear here."
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="IniInspectorContent" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="12">
                                    <StackPanel>
                                        <Border x:Name="IniContextVisual"
                                                 Height="180"
                                                 Background="#FF000000"
                                                 CornerRadius="7"
                                                 ClipToBounds="True">
                                            <Grid>
                                                <Viewbox x:Name="IniContextHitObjectStage"
                                                         Stretch="Uniform"
                                                         Visibility="Collapsed">
                                                    <Canvas Width="260" Height="170" Background="#FF000000">
                                                        <Ellipse x:Name="IniContextHitSwatch"
                                                                 Width="28"
                                                                 Height="28"
                                                                 Canvas.Left="218"
                                                                 Canvas.Top="12"
                                                                 Fill="{DynamicResource Brush.AccentPink}" />
                                                        <Image x:Name="IniContextHitApproach" Width="154" Height="154" Canvas.Left="53" Canvas.Top="8" />
                                                        <Image x:Name="IniContextHitCircle" Width="104" Height="104" Canvas.Left="78" Canvas.Top="33" />
                                                        <Image x:Name="IniContextHitOverlayBelow" Width="104" Height="104" Canvas.Left="78" Canvas.Top="33" />
                                                        <Image x:Name="IniContextHitNumber" Width="35" Height="46" Canvas.Left="112.5" Canvas.Top="62" />
                                                        <Image x:Name="IniContextHitOverlayAbove" Width="104" Height="104" Canvas.Left="78" Canvas.Top="33" />
                                                    </Canvas>
                                                </Viewbox>
                                                <Viewbox x:Name="IniContextSliderStage"
                                                         Stretch="Uniform"
                                                         Visibility="Collapsed">
                                                    <Canvas Width="800" Height="300" Background="#FF000000">
                                                        <Image x:Name="IniContextSlider" Width="800" Height="300" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" />
                                                        <Image x:Name="IniContextSliderHead" Width="92" Height="92" Canvas.Left="81" Canvas.Top="131" />
                                                        <Image x:Name="IniContextSliderHeadOverlay" Width="92" Height="92" Canvas.Left="81" Canvas.Top="131" />
                                                        <Image x:Name="IniContextSliderNumber" Width="35" Height="46" Canvas.Left="110" Canvas.Top="154" />
                                                        <Image x:Name="IniContextSliderTail" Width="92" Height="92" Canvas.Left="630" Canvas.Top="56" />
                                                        <Image x:Name="IniContextSliderTailOverlay" Width="92" Height="92" Canvas.Left="630" Canvas.Top="56" />
                                                        <Image x:Name="IniContextSliderBall" Width="104" Height="104" Canvas.Left="379" Canvas.Top="93" />
                                                    </Canvas>
                                                </Viewbox>
                                                <Ellipse x:Name="IniContextColour"
                                                         Width="54"
                                                         Height="54"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource Brush.AccentPink}"
                                                         Visibility="Collapsed" />
                                                <Image x:Name="IniContextAsset"
                                                       Width="84"
                                                       Height="84"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform" />
                                                <TextBlock x:Name="IniContextFallback"
                                                           Text="&#xE713;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="30"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="IniContextTitle"
                                                   Text="Rich skin.ini editor"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,12,0,0" />
                                        <TextBlock x:Name="IniContextHelp"
                                                   Text="Select a setting to see what it affects."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,9" />
                                        <TextBlock Text="AFFECTS" Style="{StaticResource SkinLabel}" Margin="0,0,0,5" />
                                        <WrapPanel x:Name="IniContextAffects" />
                                        <Border Margin="0,14,0,0"
                                                Padding="9"
                                                Background="{DynamicResource Brush.ControlBackground}"
                                                CornerRadius="6">
                                            <TextBlock Text="Form mode covers supported osu! skin settings. Use Raw for repeated Mania sections, comments, and future keys."
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="1"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <Button x:Name="SaveIniButton"
                                            Content="Add skin.ini to changes"
                                            Style="{StaticResource Button.Primary}"
                                            Height="32"
                                            IsEnabled="False"
                                            Click="SaveIni_Click" />
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ReviewInspectorContent"
                              Grid.Row="1"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DraftChangesLabel"
                                               Text="No changes waiting"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Review exactly what will be written to osu!lazer."
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                                <Button x:Name="UndoDraftButton"
                                        Grid.Column="1"
                                        Content="Undo"
                                        Style="{StaticResource SkinAction}"
                                        Margin="6,0,0,0"
                                        Click="UndoDraft_Click"
                                        IsEnabled="False" />
                                <Button x:Name="RedoDraftButton"
                                        Grid.Column="2"
                                        Content="Redo"
                                        Style="{StaticResource SkinAction}"
                                        Margin="6,0,0,0"
                                        Click="RedoDraft_Click"
                                        IsEnabled="False" />
                                <Button x:Name="DiscardAllDraftButton"
                                        Grid.Column="3"
                                        Content="Discard all"
                                        Style="{StaticResource SkinAction}"
                                        Margin="6,0,0,0"
                                        Click="DiscardAllDraftChanges_Click"
                                        IsEnabled="False" />
                            </Grid>
                            <ListBox x:Name="DraftChangesList"
                                     Grid.Row="1"
                                     Margin="12,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Items[0].GroupLabel}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.AccentPink}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="Discard action"
                                                            Tag="{Binding Items}"
                                                            Click="DiscardDraftAction_Click"
                                                            Style="{StaticResource SkinAction}" />
                                                </Grid>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type skins:SkinDraftChange}">
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Filename}" />
                                                <TextBlock Text="{Binding Filename}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Discard"
                                                    Tag="{Binding}"
                                                    Click="DiscardDraftChange_Click"
                                                    Style="{StaticResource SkinAction}"
                                                    Margin="7,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="DraftEmptyState"
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="18">
                                <TextBlock Text="No changes waiting to be saved"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="Edit an element or skin.ini setting, then choose Add to changes."
                                           Margin="0,4,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="DraftPreflightText"
                                               Text="Open Changes to run the compatibility check."
                                               Margin="1,0,1,7"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Nothing changes in osu!lazer until you save. Kumori creates a restore point first."
                                               Margin="1,0,1,7"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ReviewApplyButton"
                                            Content="Save to osu!lazer"
                                            Style="{StaticResource Button.Primary}"
                                            Height="32"
                                            IsEnabled="False"
                                            Click="SaveAll_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="WelcomePanel"
                    Grid.Row="1"
                    Panel.ZIndex="50"
                    Margin="10"
                    Background="{DynamicResource Brush.AppBackground}"
                    Visibility="Collapsed">
                <Border Width="620"
                        MaxWidth="620"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SkinPanel}">
                    <StackPanel>
                        <TextBlock Text="Start in Skin Studio"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Choose an existing lazer skin, build a new one from reusable Extras, or begin completely blank."
                                   Margin="20,7,20,20"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button Content="Choose an existing skin"
                                Style="{StaticResource Button.Primary}"
                                Height="38"
                                Click="ChooseExistingSkin_Click" />
                        <Button Content="Build a new skin from Extras"
                                Style="{StaticResource SkinAction}"
                                Height="36"
                                Margin="0,8,0,0"
                                Click="CreateSkinFromExtras_Click" />
                        <Button Content="Create a blank skin"
                                Style="{StaticResource SkinAction}"
                                Height="36"
                                Margin="0,8,0,0"
                                Click="CreateBlankSkin_Click" />
                        <Button Content="Import an .osk into Extras"
                                Style="{StaticResource SkinAction}"
                                Height="36"
                                Margin="0,8,0,0"
                                Click="ImportSkinToExtras_Click" />
                        <Border Margin="0,18,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Brush.ControlBackground}"
                                CornerRadius="6">
                            <TextBlock Text="Safe editing: previews and Changes stay inside Kumori until you explicitly save to osu!lazer. A restore point is created before every write."
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.PanelBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock x:Name="StatusText"
                       Text="Ready."
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Border x:Name="ExtrasWorkspace"
                Grid.RowSpan="3"
                Panel.ZIndex="700"
                Background="{DynamicResource Brush.AppBackground}"
                Visibility="Collapsed">
            <ContentControl x:Name="ExtrasHost" />
        </Border>

        <Border x:Name="BusyInputShield"
                Grid.RowSpan="3"
                Panel.ZIndex="900"
                Background="#01000000"
                Focusable="True"
                Visibility="Collapsed"
                AutomationProperties.Name="Skin editor busy" />

        <Popup x:Name="SkinColorPickerPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               HorizontalOffset="-150"
               VerticalOffset="5">
            <local:CustomThemeColorPicker x:Name="IntegratedSkinColorPicker" />
        </Popup>
    </Grid>
</UserControl>
