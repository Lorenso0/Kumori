<UserControl x:Class="Kumori.App.Skins.SkinEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kumori.App"
             xmlns:skins="clr-namespace:Kumori.App.Skins"
             MinWidth="0"
             MinHeight="0"
             Background="{DynamicResource Brush.AppBackground}"
             PreviewKeyDown="SkinEditor_PreviewKeyDown"
             PreviewKeyUp="SkinEditor_PreviewKeyUp">
    <UserControl.Resources>
        <Style x:Key="SkinPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ThemeCard}" />
        </Style>
        <Style x:Key="SkinLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.LabelUpper}">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="SkinAction" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
        </Style>
        <Style x:Key="SkinCompactAction" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="SkinIconAction" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SkinSegment" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SegmentChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource Brush.ControlHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
                                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{DynamicResource Brush.StrongBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SkinSegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="SkinWorkspaceHost" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameplayPreviewCard" TargetType="Border" BasedOn="{StaticResource SkinPanel}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="IniSettingRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.ControlHoverBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DrawingBrush x:Key="TransparencyGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Brush.CardBackground}"
                                     Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource Brush.ControlBackground}"
                                     Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.PanelBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="HeaderTitlePanel" VerticalAlignment="Center">
                    <TextBlock Text="Skin Studio"
                               FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="22" />
                    <TextBlock x:Name="RootPathText"
                               Text="Discovering osu!lazer…"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="10"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveSkinLabel"
                                   Text="SELECT A SKIN"
                                   Style="{StaticResource SkinLabel}"
                                   Margin="2,0,0,2" />
                        <ComboBox x:Name="CompactSkinPicker"
                                  MinWidth="180"
                                  Height="32"
                                  HorizontalAlignment="Stretch"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  TextSearch.TextPath="DisplayName"
                                  ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                                  SelectionChanged="CompactSkinPicker_SelectionChanged"
                                  KeyUp="CompactSkinPicker_KeyUp"
                                  AutomationProperties.Name="Active lazer skin"
                                  AutomationProperties.HelpText="Type to filter or open the list to switch skins.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Creator}"
                                                       FontSize="9"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                       Opacity="0.74"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Files.Count}"
                                                   FontSize="9"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                   Opacity="0.74"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Files in this skin" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="New"
                            Style="{StaticResource SkinAction}"
                            Margin="10,0,0,0"
                            ToolTip="Create a blank skin and start building it from Extras"
                            AutomationProperties.Name="Create blank skin"
                            Click="CreateBlankSkin_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Blank skin" Click="CreateBlankSkin_Click" />
                                <MenuItem Header="Build from Extras…" Click="CreateSkinFromExtras_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Grid.Column="2"
                            Margin="10,0,0,0"
                            Style="{StaticResource SkinSegmentGroup}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ElementsModeButton"
                                          Content="Elements"
                                          Tag="Elements"
                                          Style="{StaticResource SkinSegment}"
                                          Click="WorkspaceMode_Click"
                                          IsChecked="True" />
                            <ToggleButton x:Name="IniWorkspaceModeButton"
                                          Content="skin.ini"
                                          Tag="SkinIni"
                                          Style="{StaticResource SkinSegment}"
                                          Click="WorkspaceMode_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="HeaderUndoButton"
                            Content="&#x21B6;"
                            Style="{StaticResource SkinIconAction}"
                            ToolTip="Undo last change"
                            Click="UndoDraft_Click"
                            IsEnabled="False" />
                    <Button x:Name="HeaderRedoButton"
                            Content="&#x21B7;"
                            Style="{StaticResource SkinIconAction}"
                            Margin="4,0,0,0"
                            ToolTip="Redo change"
                            Click="RedoDraft_Click"
                            IsEnabled="False" />
                    <Button x:Name="DraftReviewButton"
                            Content="Changes"
                            Style="{StaticResource SkinAction}"
                            Margin="8,0,0,0"
                            Click="DraftReview_Click" />
                    <Button Content="Color chaos"
                            Style="{StaticResource SkinAction}"
                            Margin="6,0,0,0"
                            ToolTip="Randomize every image plus hitcircle, slider-border, and slider-track colours as one action"
                            Click="RandomizeAllElementColors_Click" />
                    <Button x:Name="CompactActionsButton"
                            Content="&#x2026;"
                            Style="{StaticResource SkinIconAction}"
                            Margin="6,0,0,0"
                            Click="CompactActions_Click"
                            AutomationProperties.Name="Skin editor actions">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Change lazer folder…" Click="ChangeFolder_Click" />
                                <MenuItem Header="Refresh skin library" Click="Refresh_Click" />
                                <MenuItem Header="Duplicate skin&#x2026;" Click="DuplicateSkin_Click" />
                                <MenuItem Header="Rename skin / author…" Click="EditSkinIdentity_Click" />
                                <MenuItem Header="Delete current skin…"
                                          Foreground="{DynamicResource Brush.Danger}"
                                          Click="DeleteSkin_Click" />
                                <MenuItem Header="Reset current category" Click="ResetCurrentCategory_Click" />
                                <Separator />
                                <MenuItem Header="Open Extras folder" Click="OpenExtrasFolder_Click" />
                                <MenuItem Header="Check Extras for updates"
                                          Click="CheckExtrasUpdates_Click" />
                                <MenuItem Header="Replace from Extras…" Click="ReplaceFromExtras_Click" />
                                <MenuItem Header="Extract skin to Extras…" Click="ExtractExtras_Click" />
                                <Separator />
                                <MenuItem Header="Back up current skin elements" Click="Backup_Click" />
                                <MenuItem Header="Restore elements from backup…"
                                          Click="RestoreElementsFromBackup_Click" />
                                <MenuItem Header="Open current skin backup folder"
                                          Click="OpenSkinBackupFolder_Click" />
                                <MenuItem x:Name="AutoBackupElementsMenuItem"
                                          Header="Automatically back up edited elements"
                                          IsCheckable="True"
                                          Click="AutoBackupElements_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SaveAllButton"
                            Content="Save to osu!lazer"
                            Style="{StaticResource Button.Primary}"
                            Height="30"
                            Padding="12,0"
                            Margin="6,0,0,0"
                            IsEnabled="False"
                            Click="SaveAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="StudioBody" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="FirstRunGuide"
                    Grid.Row="0"
                    Margin="10,8,10,0"
                    Padding="10,7"
                    Background="{DynamicResource Brush.CardSelectedBackground}"
                    BorderBrush="{DynamicResource Brush.AccentPink}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <Grid>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,70,0">
                        <Run Text="1  Choose an element" FontWeight="SemiBold" />
                        <Run Text="   →   2  Preview and edit   →   3  Add to Changes   →   4  Save to osu!lazer" />
                    </TextBlock>
                    <Button HorizontalAlignment="Right"
                            Content="Got it"
                            Style="{StaticResource SkinCompactAction}"
                            Margin="12,0,0,0"
                            Click="DismissFirstRunGuide_Click" />
                </Grid>
            </Border>

            <Border x:Name="CompactSurfaceBar"
                    Margin="8,8,8,0"
                    Style="{StaticResource SkinSegmentGroup}"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="CompactBrowseButton"
                                  Content="Browse"
                                  Tag="Browse"
                                  Style="{StaticResource SkinSegment}"
                                  Click="CompactSurface_Click" />
                    <ToggleButton x:Name="CompactCanvasButton"
                                  Content="Canvas"
                                  Tag="Canvas"
                                  Style="{StaticResource SkinSegment}"
                                  Click="CompactSurface_Click"
                                  IsChecked="True" />
                    <ToggleButton x:Name="CompactPropertiesButton"
                                  Content="Properties"
                                  Tag="Properties"
                                  Style="{StaticResource SkinSegment}"
                                  Click="CompactSurface_Click" />
                </StackPanel>
            </Border>

            <Grid x:Name="EditorGrid" Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigatorColumn" Width="256" />
                    <ColumnDefinition x:Name="NavigatorGapColumn" Width="8" />
                    <ColumnDefinition x:Name="CenterColumn" Width="*" />
                    <ColumnDefinition x:Name="InspectorGapColumn" Width="8" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <Border x:Name="NavigatorPanel"
                        Grid.Column="0"
                        Style="{StaticResource SkinPanel}"
                        Padding="10">
                    <Grid>
                        <Grid x:Name="ElementNavigatorContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ASSET LIBRARY" Style="{StaticResource SkinLabel}" Margin="2,0,0,7" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ElementSearchBox"
                                         Margin="0,0,9,0"
                                         Tag="Search elements"
                                         TextChanged="ElementSearchBox_TextChanged"
                                         AutomationProperties.Name="Search skin elements" />
                                <CheckBox x:Name="HideEmptyElementsToggle"
                                          Grid.Column="1"
                                          Content="Hide empty"
                                          VerticalAlignment="Center"
                                          ToolTip="Hide fully transparent placeholder images"
                                          AutomationProperties.Name="Hide empty placeholder images"
                                          Checked="HideEmptyElements_Changed"
                                          Unchecked="HideEmptyElements_Changed" />
                            </Grid>
                            <WrapPanel x:Name="SemanticGroupRail"
                                       Grid.Row="2"
                                       Margin="0,8,0,4" />
                            <ComboBox x:Name="CategoryPicker"
                                      Grid.Row="3"
                                      Margin="0,0,0,8"
                                      SelectionChanged="CategoryPicker_SelectionChanged"
                                      AutomationProperties.Name="Element category">
                                <ComboBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add current category to Extras..."
                                                  Click="AddCategoryToExtras_Click" />
                                    </ContextMenu>
                                </ComboBox.ContextMenu>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Expander x:Name="SkinReadinessPanel"
                                      Grid.Row="4"
                                      Header="Skin readiness"
                                      Margin="0,0,0,7"
                                      Visibility="Collapsed">
                                <Border Margin="0,5,0,0"
                                        Padding="7"
                                        Background="{DynamicResource Brush.ControlBackground}"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Fill the essentials in any order. Missing items open the matching Extras family."
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,5" />
                                        <WrapPanel x:Name="SkinReadinessItems" />
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <ToggleButton x:Name="FullElementRenderButton"
                                          Grid.Row="5"
                                          Height="36"
                                          Margin="0,0,0,6"
                                          Padding="10,0"
                                          HorizontalContentAlignment="Left"
                                          IsChecked="True"
                                          Click="FullElementRenderButton_Click"
                                          Content="Full render"
                                          ToolTip="Show the complete element without highlighting an individual asset">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="FullRenderChrome"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FullRenderChrome"
                                                        Property="Background"
                                                        Value="{DynamicResource Brush.ControlHoverBackground}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FullRenderChrome"
                                                        Property="Background"
                                                        Value="{DynamicResource Brush.CardSelectedBackground}" />
                                                <Setter TargetName="FullRenderChrome"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource Brush.AccentPink}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ListBox x:Name="ElementList"
                                     Grid.Row="6"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.CacheLength="1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     SelectionMode="Extended"
                                     AllowDrop="True"
                                     SelectionChanged="ElementList_SelectionChanged"
                                     PreviewMouseRightButtonDown="ElementList_PreviewMouseRightButtonDown"
                                     KeyDown="ElementList_KeyDown"
                                     DragOver="ElementList_DragOver"
                                     Drop="ElementList_Drop"
                                     AutomationProperties.Name="Skin elements">
                                <ListBox.ContextMenu>
                                    <ContextMenu Closed="ElementContextMenu_Closed">
                                        <MenuItem Header="Copy element(s)" InputGestureText="Ctrl+C" Click="CopyElements_Click" />
                                        <MenuItem Header="Paste element(s)" InputGestureText="Ctrl+V" Click="PasteElements_Click" />
                                        <MenuItem Header="Add selected element(s) to Extras..."
                                                  Click="AddSelectedElementsToExtras_Click" />
                                        <Separator />
                                        <MenuItem Header="Replace file…" Click="ReplaceFile_Click" />
                                        <MenuItem Header="Make transparent"
                                                  Click="MakeContextElementTransparent_Click" />
                                        <MenuItem Header="Delete"
                                                  Click="DeleteContextElement_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type skins:SkinElementEntry}">
                                        <Grid Height="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="46"
                                                    Height="46"
                                                    Background="{DynamicResource Brush.ControlBackground}"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Margin="4"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="LowQuality"
                                                           Loaded="ElementThumbnail_Loaded">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVisiblePixels}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="&#xE8D6;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Filename}"
                                                           ToolTip="{Binding Filename}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ResolutionVariantLabel}"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPairedResolution}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding EditState}"
                                                               Margin="6,0,0,0"
                                                               Foreground="{DynamicResource Brush.AccentPink}"
                                                               FontSize="9" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2"
                                                     Width="6"
                                                     Height="6"
                                                     Margin="4"
                                                     Fill="{DynamicResource Brush.AccentPink}"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEdits}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="ElementEmptyState"
                                        Grid.Row="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="12"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="ElementEmptyTitle"
                                           Text="Nothing here yet"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ElementEmptyHint"
                                           Text="Browse Extras or import files to fill this category."
                                           FontSize="9"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,3,0,8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Browse Extras"
                                            Style="{StaticResource Button.Primary}"
                                            Height="28"
                                            Padding="11,0"
