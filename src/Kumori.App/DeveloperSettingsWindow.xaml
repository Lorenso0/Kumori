<Window x:Class="Kumori.App.DeveloperSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kumori Developer Settings"
        Width="720" Height="680"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ThemeCard}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Developer settings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Diagnostics, recovery testing, log retention, and cache activity."
                           Style="{StaticResource Text.Metadata}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Diagnostic capture" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="These options are intended for tracker development and controlled testing."
                                   Style="{StaticResource SettingsHint}" />
                        <CheckBox x:Name="PacketRecordingEnabled" Content="Record raw tosu packet fixtures" />
                        <TextBlock Text="Writes every raw tosu WebSocket packet to timestamped JSONL fixture files. Leave this disabled during normal use because recordings can consume significant disk space."
                                   Style="{StaticResource Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="16,-2,0,0" />
                        <Separator Margin="0,12" />
                        <CheckBox x:Name="ForceReplayRecoveryNextPlay" Content="Test replay recovery on the next play" />
                        <TextBlock Text="One shot: discards the next play's tosu result values, recovers completed plays from a local replay or partial plays from retained frames, restarts tosu when telemetry is missing, and refreshes the dashboard."
                                   Style="{StaticResource Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="16,-2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Logs" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Retention applies recursively to app, crash, replay viewer, tosu, cache-addition, legacy, and helper-tool logs. Plain logs also rotate at 10 MB."
                                   Style="{StaticResource SettingsHint}" />
                        <WrapPanel>
                            <TextBlock Text="Keep logs for" Style="{StaticResource Text.Metadata}" Margin="0,7,8,0" />
                            <TextBox x:Name="LogRetentionDays" Width="70" Margin="0,0,8,0" />
                            <TextBlock Text="days" Style="{StaticResource Text.Metadata}" Margin="0,7,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Windows startup" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Read the live per-user Windows startup registration and show the executable it will launch."
                                   Style="{StaticResource SettingsHint}" />
                        <Button Content="Show automatic startup executable"
                                Click="ShowStartupExecutable_Click"
                                HorizontalAlignment="Left" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartupExecutablePath"
                                     IsReadOnly="True"
                                     Visibility="Collapsed"
                                     TextWrapping="Wrap"
                                     Padding="8,5" />
                            <Button Grid.Column="1"
                                    Content="Select new .exe"
                                    Click="SelectStartupExecutable_Click"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="A selected executable is registered when you save. Leave the startup option disabled to save it for later without launching it at sign-in."
                                   Style="{StaticResource Text.Muted}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Cache additions" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Inspect why Kumori added or installed each local cache item. Newest entries appear first."
                                   Style="{StaticResource SettingsHint}" />
                        <TextBlock x:Name="CacheActivityPath" Style="{StaticResource Text.Muted}" FontSize="10"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                        <Grid Height="210" Margin="0,0,0,8">
                            <ListBox x:Name="CacheActivityList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Brush.TextMuted}"
                                                       FontSize="10" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="CacheActivityEmpty" Text="No cache additions have been recorded yet."
                                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <WrapPanel>
                            <Button Content="Refresh" Click="RefreshCacheLog_Click" Margin="0,0,8,0" />
                            <Button Content="Open cache-additions.jsonl" Click="OpenCacheLog_Click" Margin="0,0,8,0" />
                            <Button Content="Open cache folder" Click="OpenCacheFolder_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Content="Save" Click="Save_Click" IsDefault="True" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
