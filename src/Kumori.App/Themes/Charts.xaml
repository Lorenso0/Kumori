<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ChartPanel" TargetType="Border">
        <Setter Property="Background" Value="#100D18" />
        <Setter Property="BorderBrush" Value="#2A1424" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="ChartTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.LabelUpper}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
</ResourceDictionary>
