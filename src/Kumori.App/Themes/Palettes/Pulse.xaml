<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.AppBackground">#10091A</Color>
    <Color x:Key="Color.PanelBackground">#20102D</Color>
    <Color x:Key="Color.CardBackground">#2A1539</Color>
    <Color x:Key="Color.CardHoverBackground">#42205B</Color>
    <Color x:Key="Color.CardSelectedBackground">#51225E</Color>
    <Color x:Key="Color.ControlBackground">#241330</Color>
    <Color x:Key="Color.ControlHoverBackground">#3D2051</Color>
    <Color x:Key="Color.SubtleBorder">#8A4E9C</Color>
    <Color x:Key="Color.StrongBorder">#FF4EB8</Color>
    <Color x:Key="Color.AccentPink">#FF4EB8</Color>
    <Color x:Key="Color.AccentPurple">#A96BFF</Color>
    <Color x:Key="Color.TextPrimary">#FFF8FF</Color>
    <Color x:Key="Color.TextSecondary">#E9C9F3</Color>
    <Color x:Key="Color.TextMuted">#BCA5C8</Color>
    <Color x:Key="Color.Success">#52F09A</Color>
    <Color x:Key="Color.Warning">#FFD95A</Color>
    <Color x:Key="Color.Danger">#FF668A</Color>
    <Color x:Key="Color.Cyan">#56D9FF</Color>
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="{StaticResource Color.PanelBackground}" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}" />
    <SolidColorBrush x:Key="Brush.CardHoverBackground" Color="{StaticResource Color.CardHoverBackground}" />
    <SolidColorBrush x:Key="Brush.CardSelectedBackground" Color="{StaticResource Color.CardSelectedBackground}" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="{StaticResource Color.ControlBackground}" />
    <SolidColorBrush x:Key="Brush.ControlHoverBackground" Color="{StaticResource Color.ControlHoverBackground}" />
    <SolidColorBrush x:Key="Brush.SubtleBorder" Color="{StaticResource Color.SubtleBorder}" />
    <SolidColorBrush x:Key="Brush.StrongBorder" Color="{StaticResource Color.StrongBorder}" />
    <SolidColorBrush x:Key="Brush.AccentPink" Color="{StaticResource Color.AccentPink}" />
    <SolidColorBrush x:Key="Brush.AccentPurple" Color="{StaticResource Color.AccentPurple}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}" />
    <SolidColorBrush x:Key="Brush.BackgroundPrimary" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.BackgroundSecondary" Color="{StaticResource Color.PanelBackground}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.SubtleBorder}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#713E82" />
    <SolidColorBrush x:Key="Brush.Negative" Color="{StaticResource Color.Danger}" />
    <LinearGradientBrush x:Key="Brush.NavigationBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30113E"/><GradientStop Color="#190B26" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TopBarBackground" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#32113B"/><GradientStop Color="#160A22" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#D810091A" />
    <LinearGradientBrush x:Key="Brush.MetricBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B1C4F"/><GradientStop Color="#281435" Offset="1"/></LinearGradientBrush>
    <CornerRadius x:Key="Radius.ThemeCard">10</CornerRadius>
    <Thickness x:Key="Space.ThemePage">14</Thickness>
</ResourceDictionary>
