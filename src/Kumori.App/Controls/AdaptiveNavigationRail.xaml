<UserControl x:Class="Kumori.App.Controls.AdaptiveNavigationRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kumori.App.Controls"
             xmlns:vm="clr-namespace:Kumori.App.ViewModels"
             HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="7,0" /><Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="ActiveNavigationButton" TargetType="Button" BasedOn="{StaticResource NavigationButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Visibility" Value="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:AdaptiveNavigationRail}}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.NavigationBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,1,0">
        <Grid Margin="6,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Visibility="Collapsed" Click="Toggle_Click" Style="{StaticResource NavigationButton}" Margin="0,0,0,8" ToolTip="Expand or collapse navigation">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="K" Foreground="{DynamicResource Brush.AppBackground}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Kumori" Style="{StaticResource NavigationLabel}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14" />
                    <TextBlock Grid.Column="2" Text="&#xE76B;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0"
                               Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:AdaptiveNavigationRail}}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                </Grid>
            </Button>

            <Button x:Name="DashboardButton" Grid.Row="1" Click="Dashboard_Click" Style="{StaticResource NavigationButton}" ToolTip="Dashboard"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Dashboard" Style="{StaticResource NavigationLabel}"/></Grid></Button>
            <Button x:Name="PerformanceButton" Grid.Row="2" Click="Performance_Click" Style="{StaticResource NavigationButton}" ToolTip="Performance"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Performance" Style="{StaticResource NavigationLabel}"/></Grid></Button>
            <Button x:Name="MapsButton" Grid.Row="3" Click="Maps_Click" Style="{StaticResource NavigationButton}" ToolTip="Maps"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE81D;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Maps" Style="{StaticResource NavigationLabel}"/></Grid></Button>
            <Button Grid.Row="8" Click="Toggle_Click" Style="{StaticResource NavigationButton}" ToolTip="Expand or collapse sidebar"
                    Visibility="{Binding CanToggle, RelativeSource={RelativeSource AncestorType={x:Type local:AdaptiveNavigationRail}}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE76C;"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:AdaptiveNavigationRail}}}" Value="True"><Setter Property="Text" Value="&#xE76B;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="Collapse" Style="{StaticResource NavigationLabel}" FontWeight="Normal" Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>
            </Button>
            <Button Grid.Row="9" Click="Changelog_Click" Style="{StaticResource NavigationButton}" ToolTip="Changelog">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Changelog" Style="{StaticResource NavigationLabel}"/>
                </Grid>
            </Button>
            <Button Grid.Row="10" Click="Discord_Click" Style="{StaticResource NavigationButton}" ToolTip="Join the Kumori Discord">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M20.3,4.4 C18.8,3.7 17.2,3.2 15.5,2.9 L14.9,4.1 C13,3.8 11,3.8 9.1,4.1 L8.5,2.9 C6.8,3.2 5.2,3.7 3.7,4.4 C0.8,8.7 0,12.9 0.4,17 C2.4,18.5 4.4,19.4 6.4,20 L7.9,18 C7.1,17.7 6.3,17.3 5.6,16.8 L6.1,16.4 C10.1,18.2 14.3,18.2 18.2,16.4 L18.8,16.8 C18.1,17.3 17.3,17.7 16.5,18 L18,20 C20,19.4 22,18.5 24,17 C24.5,12.2 23.2,8 20.3,4.4 Z M8.2,14.4 C7,14.4 6,13.3 6,11.9 C6,10.5 7,9.4 8.2,9.4 C9.5,9.4 10.4,10.5 10.4,11.9 C10.4,13.3 9.4,14.4 8.2,14.4 Z M15.8,14.4 C14.6,14.4 13.6,13.3 13.6,11.9 C13.6,10.5 14.6,9.4 15.8,9.4 C17,9.4 18,10.5 18,11.9 C18,13.3 17,14.4 15.8,14.4 Z" />
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="Discord" Style="{StaticResource NavigationLabel}"/>
                </Grid>
            </Button>
            <Button x:Name="SettingsButton" Grid.Row="11" Click="Settings_Click" Style="{StaticResource NavigationButton}" ToolTip="Settings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource NavigationLabel}"/></Grid></Button>
        </Grid>
    </Border>
</UserControl>
