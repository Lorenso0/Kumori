<Window x:Class="Kumori.App.WallpaperSourceResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper source results"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wallpaper source results"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Searching the stored wallpaper…" />
            </StackPanel>
            <ProgressBar x:Name="SearchProgress"
                         Grid.Column="1"
                         Width="150"
                         Height="4"
                         VerticalAlignment="Center"
                         IsIndeterminate="True" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.CardBackground}"
                    BorderBrush="{DynamicResource Brush.SubtleBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding Results}"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ResultsList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112"
                                        Height="72"
                                        Background="{DynamicResource Brush.PanelBackground}"
                                        BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Image Source="{Binding Thumbnail, Mode=OneWay}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result.Title, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Result.ResolutionText, Mode=OneWay}"
                                               Foreground="{DynamicResource Brush.Cyan}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding SummaryText, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.CardBackground}"
                    BorderBrush="{DynamicResource Brush.SubtleBorder}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Background="{DynamicResource Brush.PanelBackground}"
                                CornerRadius="4">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="PreviewStatusText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="Select a result to preview it" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="SelectedTitleText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedDetailsText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBox x:Name="SourceAddressText"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 ToolTip="Source page address" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Results are ordered by resolution, then match confidence." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopySourceButton"
                        Content="Copy source address"
                        IsEnabled="False"
                        Click="CopySourceButton_Click"
                        Style="{StaticResource Button.Chrome}" />
                <Button x:Name="SaveButton"
                        Margin="8,0,0,0"
                        Content="Save locally"
                        IsEnabled="False"
                        Click="SaveButton_Click"
                        Style="{StaticResource Button.Primary}" />
                <Button Margin="8,0,0,0"
                        Content="Close"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Style="{StaticResource Button.Chrome}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
