<Window x:Class="Kumori.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kumori.App.ViewModels"
        xmlns:controls="clr-namespace:Kumori.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kumori"
        Background="{DynamicResource Brush.AppBackground}"
        Width="1180" Height="820"
        MinWidth="720" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <!--
        Compact dashboard layout.
        Window is a single Grid, top to bottom: status/actions, metrics strip,
        account/sync line, filters, main split.
    -->
    <Window.Resources>
        <Style x:Key="TopActionButton" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TopActionButtonOutline" TargetType="Button" BasedOn="{StaticResource TopActionButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PagePanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ThemeCard}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="PageSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="FilterChipButton" TargetType="Button" BasedOn="{StaticResource TopActionButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="FilterRadioButton" TargetType="RadioButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.StrongBorder}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.StrongBorder}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ChartLegendCheckBox" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Box"
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,5,0"
                                        Background="{DynamicResource Brush.ControlBackground}"
                                        BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                        BorderThickness="1"
                                        CornerRadius="1">
                                    <Path x:Name="Check"
                                          Data="M 2 6 L 5 9 L 10 3"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.StrongBorder}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource Brush.AppBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition x:Name="TabHeaderRow" Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border x:Name="TabHeader"
                                    Background="{DynamicResource Brush.PanelBackground}"
                                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="8,5,8,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Single">
                                <Setter TargetName="TabHeaderRow" Property="Height" Value="0" />
                                <Setter TargetName="TabHeader" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="11,0,6,0" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,5,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Brush.ControlHoverBackground}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type controls:HitTimingGraph}">
            <Setter Property="PointBrush" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="EarlyPointBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="LatePointBrush" Value="{DynamicResource Brush.AccentPurple}" />
            <Setter Property="BandBrush" Value="{DynamicResource Brush.CardSelectedBackground}" />
            <Setter Property="GridBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="MeanBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="HoverBrush" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="AxisTextBrush" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style TargetType="{x:Type controls:MapPressureGraph}">
            <Setter Property="FillBrush" Value="{DynamicResource Brush.CardSelectedBackground}" />
            <Setter Property="LineBrush" Value="{DynamicResource Brush.AccentPurple}" />
            <Setter Property="BaselineBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="MissBrush" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="BreakBrush" Value="{DynamicResource Brush.Warning}" />
            <Setter Property="UrBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="GraphTextBrush" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <!-- Metrics strip: panel cells with a single right divider -->
        <Style x:Key="MetricCellCompact" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.MetricBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ThemeCard}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="MetricIconBubble" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Bordered (not filled) stat grid cells for the inspector -->
        <Style x:Key="StatCellPrimary" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,9" />
        </Style>

        <Style x:Key="StatCellSecondary" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="5,8" />
        </Style>

        <Style x:Key="CompactRowGhostButton" TargetType="Button" BasedOn="{StaticResource RowGhostButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HeaderChevronButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter TargetName="FocusBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderCloseButton" TargetType="Button" BasedOn="{StaticResource HeaderChevronButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PlayCardTemplate">
            <Grid MinHeight="92" ClipToBounds="True" ToolTip="{Binding DifficultyLine}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="58" Height="58" Margin="7,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.ControlBackground}" CornerRadius="7" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ArtworkSource}"
                               Stretch="UniformToFill"
                               Visibility="{Binding DataContext.IsThumbnailArtwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                        <Border Background="#0C000000" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="7,10,8,4"
                      ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}"
                               MinHeight="16"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding Artist}"
                               MinHeight="14"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding DifficultyLine}"
                               MinHeight="15"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding DifficultyLine}" />
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding ModEntries}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  MinHeight="25"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="27"
                                      Height="21"
                                      Margin="0,0,3,2"
                                      ToolTip="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}"
                                      ToolTipService.InitialShowDelay="0"
                                      ToolTipService.BetweenShowDelay="0"
                                      ToolTipService.ShowDuration="60000"
                                      ToolTipService.Placement="Top"
                                      ToolTipService.VerticalOffset="-2"
                                      AutomationProperties.Name="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}">
                                    <Polygon Points="2,10.5 7,1 20,1 25,10.5 20,20 7,20"
                                             Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToBrushConverter.Instance}}" />
                                    <Rectangle x:Name="ModIcon"
                                               Width="16"
                                               Height="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToForegroundBrushConverter.Instance}}"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush Stretch="Uniform"
                                                        ImageSource="{Binding Acronym, Converter={x:Static vm:ModAcronymToIconSourceConverter.Instance}}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock x:Name="ModFallback"
                                               Text="{Binding Acronym}"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Foreground="{Binding Acronym, Converter={x:Static vm:ModAcronymToForegroundBrushConverter.Instance}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Acronym, Converter={x:Static vm:ModAcronymToIconSourceConverter.Instance}}" Value="{x:Null}">
                                        <Setter TargetName="ModIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ModFallback" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                    <Border Grid.Column="1"
                            Width="198"
                            Margin="5,8,12,8"
                            Padding="8,0"
                            Background="{DynamicResource Brush.ControlBackground}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding DataContext.IsWideHistoryLayout, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                        <UniformGrid Columns="3" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SCORE" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ScoreText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PROGRESS" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MISSES" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding MissesText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>

                <Border Grid.Column="2"
                        Margin="4,6,5,6"
                        Padding="7,6"
                        Background="{DynamicResource Brush.ControlBackground}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <controls:RankProgressBadge Width="38" Height="38"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    RankText="{Binding Grade}" Progress="{Binding GradeProgress}"
                                                    AccentBrush="{DynamicResource Brush.AccentPink}"
                                                    TrackBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BackgroundBrush="{DynamicResource Brush.CardBackground}"
                                                    TextBrush="{DynamicResource Brush.TextPrimary}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{Binding AccuracyToolTip}">
                                <TextBlock Text="{Binding AccuracyText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding PerformanceLine}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.AccentPink}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding OutcomeWithProgress}"
                                       ToolTip="{Binding OutcomeWithProgress}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0">
                                <TextBlock.Foreground><SolidColorBrush Color="{Binding OutcomeColor}" /></TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding WhenRelative}"
                                       ToolTip="{Binding WhenExact}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Column="3" Content="&#8942;" Click="CardOverflow_Click" Style="{StaticResource CompactRowGhostButton}" ToolTip="Play actions" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="AppShell" Background="{DynamicResource Brush.AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.TopBarBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="13,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://siteoforigin:,,,/assets/logo.ico"
                           Width="22" Height="22"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kumori" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="118,0,0,0">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"><Ellipse.Fill><SolidColorBrush Color="{Binding TosuChipColor}"/></Ellipse.Fill></Ellipse>
                    <TextBlock Text="{Binding TosuChipText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Button Content="{Binding UpdateAvailableText}"
                            Command="{Binding OpenAvailableUpdateCommand}"
                             Style="{StaticResource TopActionButtonOutline}"
                             Height="28"
                             MinHeight="28"
                            Padding="9,0"
                            Margin="12,0,0,0"
                            FontSize="10"
                            ToolTip="Download and install the latest Kumori update"
                            Visibility="{Binding IsUpdateAvailable, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="{Binding AppVersionText}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Click="MinimizeWindow_Click" Style="{StaticResource HeaderChevronButton}" Width="44" Height="38" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><Path Data="M 1 6 L 11 6" Width="12" Height="12" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button>
                    <Button x:Name="MaximizeWindowButton" Click="MaximizeWindow_Click" Style="{StaticResource HeaderChevronButton}" Width="44" Height="38" ToolTip="Maximize" AutomationProperties.Name="Maximize window"><Path x:Name="MaximizeGlyph" Data="M 1.5 1.5 L 10.5 1.5 L 10.5 10.5 L 1.5 10.5 Z" Width="12" Height="12" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button>
                    <Button Click="CloseWindow_Click" Style="{StaticResource HeaderCloseButton}" Width="44" Height="38" ToolTip="Close to tray" AutomationProperties.Name="Close window to tray"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Width="12" Height="12" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:AdaptiveNavigationRail x:Name="NavigationView"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         DashboardRequested="DashboardNavigation_Click"
                                         PerformanceRequested="PerformanceNavigation_Click"
                                         MapsRequested="MapsNavigation_Click"
                                         ChangelogRequested="ChangelogNavigation_Click"
                                         DiscordRequested="DiscordNavigation_Click"
                                         SettingsRequested="SettingsNavigation_Click"
                                         ToggleRequested="NavigationToggle_Click" />

        <Grid x:Name="DashboardRoot"
              Grid.Row="1"
              Grid.Column="1"
              Background="{DynamicResource Brush.AppBackground}"
              MaxWidth="1920"
              HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="42" />
            <RowDefinition x:Name="MetricsRow" Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ ROW 0: STATUS / ACTIONS ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.TopBarBackground}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock x:Name="DashboardTitleText"
                               Text="Dashboard"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,9,0,0" />
                    <TextBlock x:Name="DashboardSubtitleText"
                               Text="Overview of your recent session"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Top"
                               Margin="0,36,0,0" />
                <StackPanel x:Name="TopStatusStrip" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="-" Foreground="{DynamicResource Brush.TextMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,1" />
                    <TextBlock Text="{Binding SessionIndicator, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                    <TextBlock Text="-" Foreground="{DynamicResource Brush.AccentPink}" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,1" />
                    <TextBlock Text="{Binding TosuChipText, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0">
                        <TextBlock.Foreground><SolidColorBrush Color="{Binding TosuChipColor}" /></TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding CaptureChipText, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SyncStatusText" Text="{Binding SyncLine, Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0" />
                    <Button x:Name="EndSessionButton" Content="End Session"
                            Command="{Binding EndSessionCommand}"
                            Style="{StaticResource Button.Primary}"
                            Height="32"
                            Margin="0,0,6,0"
                            Visibility="{Binding HasActiveSession, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                    <Button x:Name="TopSettingsButton" Content="Import"
                            Command="{Binding Inspector.ValidateOsrCommand}"
                            Style="{StaticResource TopActionButton}"
                            Margin="0,0,6,0" Visibility="Collapsed" />
                    <Button x:Name="ActionsButton" Visibility="Collapsed" Click="ActionsButton_Click" Style="{StaticResource TopActionButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#8942;" FontSize="16" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Refresh dashboard" Command="{Binding RefreshCommand}" />
                                <Separator />
                                <MenuItem Header="Setup &amp; integrations" IsEnabled="False" />
                                <MenuItem Header="Setup wizard" Command="{Binding OpenSetupWizardCommand}" />
                                <MenuItem Header="Skin library" Command="{Binding OpenSkinLibraryCommand}" />
                                <MenuItem Header="tosu setup" Command="{Binding OpenTosuSetupCommand}" />
                                <MenuItem Header="Launch tosu" Command="{Binding LaunchTosuCommand}" />
                                <Separator />
                                <MenuItem Header="Maintenance" IsEnabled="False" />
                                <MenuItem Header="Health dashboard" Command="{Binding OpenHealthDashboardCommand}" />
                                <MenuItem Header="Clear beatmap cache" Command="{Binding ClearBeatmapCacheCommand}" />
                                <MenuItem Header="Cleanup invalid attempts" Command="{Binding CleanupInvalidAttemptsCommand}" />
                                <MenuItem Header="Delete short plays…" Command="{Binding DeleteShortPlaysCommand}" />
                                <Separator />
                                <MenuItem Header="Tracking data" IsEnabled="False" />
                                <MenuItem Header="Delete entries before..." Command="{Binding DeleteEntriesBeforeCommand}" />
                                <MenuItem Header="Delete all tracking data" Command="{Binding DeleteAllTrackingDataCommand}" />
                                <Separator />
                                <MenuItem Header="Support" IsEnabled="False" />
                                <MenuItem Header="Report problem" Command="{Binding ExportProblemReportCommand}" />
                                <MenuItem Header="Logs" Command="{Binding OpenLogsCommand}" />
                                <MenuItem Header="AppData folder" Command="{Binding OpenAppDataCommand}" />
                                <MenuItem Header="Check for Kumori updates" Command="{Binding CheckForUpdatesCommand}" />
                                <Separator />
                                <MenuItem Header="Developer tools" IsEnabled="False" />
                                <MenuItem Header="tosu status &amp; log" Command="{Binding OpenTosuDiagnosticsCommand}" />
                                <MenuItem Header="Lazer Frame Debug" Command="{Binding OpenLazerFrameDebugCommand}" />
                                <MenuItem Header="Stable Frame Debug" Command="{Binding OpenStableFrameDebugCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Content="&#x21BB;"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource TopActionButton}"
                            Width="34"
                            Padding="0"
                            FontSize="17"
                            ToolTip="Refresh dashboard"
                            AutomationProperties.Name="Refresh dashboard" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ ROW 1: METRICS STRIP ============ -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.AppBackground}" Padding="6,3,6,5">
            <UniformGrid x:Name="MetricsGrid" Columns="6">
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="&#9654;" FontSize="10" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="PLAYS" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PlaysMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="&#9711;" FontSize="13" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="PLAYTIME" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PlaytimeMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="K" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="KEY PRESSED" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding KeysMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,1,0,0" ToolTip="{Binding KeysBreakdown}" />
                        <TextBlock Text="{Binding KeysBreakdown}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="&#9733;" FontSize="12" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="BEST" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BestMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="+" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="PP GAINED" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PpGainedMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCellCompact}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricIconBubble}"><TextBlock Text="&#8593;" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="RANKS GAINED" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RanksGainedMetric}" Style="{StaticResource Text.StatValue}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ============ ROW 2: MAIN SPLIT (play list | inspector) ============ -->
        <Grid x:Name="MainSplitGrid" Grid.Row="2" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryColumn" Width="40*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                <ColumnDefinition x:Name="InspectorColumn" Width="60*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: PLAY LIST -->
            <Border x:Name="HistoryPane" Grid.Column="0" Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.ThemeCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,1" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center" Margin="0,0,7,0">
                                <TextBox Tag="Search plays or maps..."
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search play history"
                                         AutomationProperties.HelpText="Search by map title, artist, difficulty, or mapper"
                                         Padding="24,0,10,0"
                                         Height="28"
                                         MinHeight="28"
                                         MinWidth="180"
                                         FontSize="12"
                                         VerticalAlignment="Center" />
                                <Path Data="M 6 11 A 5 5 0 1 1 11 6 A 5 5 0 1 1 6 11 M 10 10 L 15 15"
                                      Stroke="{DynamicResource Brush.TextMuted}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="11"
                                      Height="11"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="7,0,0,0"
                                      IsHitTestVisible="False" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Clear"
                                    Style="{StaticResource FilterChipButton}"
                                    ToolTip="Clear search and filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0"/>
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                                <RadioButton Content="All" Tag="All" GroupName="HistoryOutcome" Click="FilterChip_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource FilterRadioButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedFilterMode}" Value="All"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton Content="Completed" Tag="Completed" GroupName="HistoryOutcome" Click="FilterChip_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource FilterRadioButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedFilterMode}" Value="Completed"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton Content="Failed" Tag="Failed" GroupName="HistoryOutcome" Click="FilterChip_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource FilterRadioButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedFilterMode}" Value="Failed"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton Content="Retried" Tag="Retried" GroupName="HistoryOutcome" Click="FilterChip_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource FilterRadioButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedFilterMode}" Value="Retried"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <RadioButton Content="Quit" Tag="Quit" GroupName="HistoryOutcome" Click="FilterChip_Click">
                                    <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource FilterRadioButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedFilterMode}" Value="Quit"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                                </RadioButton>
                                <ToggleButton Content="Group sessions"
                                              IsChecked="{Binding IsGroupSessions}"
                                              AutomationProperties.Name="Group plays into sessions"
                                              Style="{StaticResource FilterToggleButton}" />
                            </WrapPanel>
                            <CheckBox x:Name="GroupRepeatsCheckBox" Visibility="Collapsed" Content="Group repeats" IsChecked="{Binding IsGroupRepeats}" />
                            <ComboBox x:Name="ArtworkModeComboBox" Visibility="Collapsed" ItemsSource="{Binding ArtworkModeOptions}" SelectedItem="{Binding SelectedArtworkMode}" />
                            <ComboBox x:Name="FilterModeComboBox" Visibility="Collapsed" ItemsSource="{Binding FilterModeOptions}" SelectedItem="{Binding SelectedFilterMode}" />
                            <Button x:Name="ClearFiltersButton" Visibility="Collapsed" Command="{Binding ClearFiltersCommand}" />
                            <TextBlock x:Name="ResultsTextBlock" Visibility="Collapsed" Text="{Binding ResultsText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="0" Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Play History"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResultsText}"
                                   Style="{StaticResource Text.Muted}"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <ListBox Grid.Row="0"
                             x:Name="HistoryList"
                             AutomationProperties.Name="Play history"
                             Style="{StaticResource HistoryListBox}"
                             ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedAttempt}"
                             ScrollViewer.ScrollChanged="History_ScrollChanged"
                             SelectionChanged="HistoryList_SelectionChanged"
                             Padding="5,0,5,5"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
                                <Border Margin="0"
                                        Height="44"
                                        Padding="6,0,4,0"
                                        Background="{DynamicResource Brush.CardBackground}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,1,0,1"
                                        CornerRadius="4"
                                        ToolTip="{Binding StatsLine}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Column="0"
                                                Grid.RowSpan="2"
                                                Click="SessionToggle_Click"
                                                Style="{StaticResource HeaderChevronButton}"
                                                ToolTip="{Binding ToggleLabel}"
                                                AutomationProperties.Name="{Binding ToggleLabel}">
                                            <Path Width="8"
                                                  Height="8"
                                                  Stretch="Uniform"
                                                  Data="M 0 0 L 5 4.5 L 0 9"
                                                  Stroke="{DynamicResource Brush.AccentPink}"
                                                  StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0" CenterX="4" CenterY="4" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Grid.RowSpan="2"
                                                   Text="{Binding TimeText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,7,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding HeaderLine}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Grid.Row="1"
                                                   Text="{Binding StatsLine}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-2,0,0" />
                                        <Button Grid.Column="3"
                                                Grid.RowSpan="2"
                                                Content="End Session"
                                                Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                Style="{StaticResource TopActionButtonOutline}"
                                                FontSize="10"
                                                Padding="9,0"
                                                Height="24"
                                                MinHeight="24"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding IsActive, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                        <Button Grid.Column="4" Grid.RowSpan="2" Content="&#8942;" Click="SessionOverflow_Click" Style="{StaticResource CompactRowGhostButton}" ToolTip="Session actions" />
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:AttemptRowViewModel}">
                                <Grid>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource PlayCardTemplate}" />
                                <Grid Height="58" ClipToBounds="True" Visibility="Collapsed">
                                    <Border Background="{Binding ArtworkBrush}"
                                            Visibility="{Binding DataContext.IsFullArtwork, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.12" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.16" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Image Source="{Binding ArtworkSource, Converter={x:Static vm:PanelArtworkSourceConverter.Instance}}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding DataContext.IsFullArtwork, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="0.48" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.58" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.OverlayBackground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.OverlayBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Width="3" CornerRadius="2" Margin="0,6,0,6" HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.AccentPink}"
                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />

                                    <!-- Keep every score-card value inside its grid cell. The card artwork can be busy,
                                         so these layout cells are the visual boundaries for text and mod icons. -->
                                    <Grid Margin="8,6" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <!-- Match the overflow button's 22px width. The card grid clips its
                                                 descendants, so a narrower column also clipped the click target. -->
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>

                                        <controls:RankProgressBadge Grid.Column="0"
                                                                    Width="40"
                                                                    Height="40"
                                                                    VerticalAlignment="Center"
                                                                    RankText="{Binding Grade}"
                                                                    Progress="{Binding GradeProgress}"
                                                                    AccentBrush="{DynamicResource Brush.AccentPink}"
                                                                    TrackBrush="{DynamicResource Brush.BorderSubtle}"
                                                                    BackgroundBrush="{DynamicResource Brush.CardBackground}"
                                                                    TextBrush="{DynamicResource Brush.TextPrimary}">
                                            <controls:RankProgressBadge.Style>
                                                <Style TargetType="{x:Type controls:RankProgressBadge}">
                                                    <Setter Property="Opacity" Value="0.72" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.95" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:RankProgressBadge.Style>
                                        </controls:RankProgressBadge>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding WhenShort}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />

                                        <Grid Grid.Column="2" Margin="8,0,8,0" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Column="1"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Top"
                                                    MouseEnter="ScrollingTitle_MouseEnter"
                                                    MouseLeave="ScrollingTitle_MouseLeave">
                                                <TextBlock x:Name="ScrollingTitle"
                                                           Text="{Binding MapLine}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="3" HorizontalAlignment="Stretch" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Column="0"
                                                    Grid.Row="0"
                                                    Height="23"
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top">
                                                <ItemsControl ItemsSource="{Binding ModEntries}" VerticalAlignment="Center" Focusable="False" IsTabStop="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="27"
                                                                  Height="21"
                                                                  Margin="0,0,3,0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}"
                                                                  ToolTipService.InitialShowDelay="0"
                                                                  ToolTipService.BetweenShowDelay="0"
                                                                  ToolTipService.ShowDuration="60000"
                                                                  ToolTipService.Placement="Top"
                                                                  ToolTipService.VerticalOffset="-2"
                                                                  AutomationProperties.Name="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}">
                                                                <Polygon Points="2,10.5 7,1 20,1 25,10.5 20,20 7,20"
                                                                         Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToBrushConverter.Instance}}" />
                                                                <Rectangle Width="16"
                                                                           Height="16"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToForegroundBrushConverter.Instance}}"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Rectangle.OpacityMask>
                                                                        <ImageBrush Stretch="Uniform"
                                                                                    ImageSource="{Binding Acronym, Converter={x:Static vm:ModAcronymToIconSourceConverter.Instance}}" />
                                                                    </Rectangle.OpacityMask>
                                                                </Rectangle>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Outcome}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Foreground><SolidColorBrush Color="{Binding OutcomeColor}" /></TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PpText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.AccentPink}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ClipToBounds="True" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ComboText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           TextAlignment="Right"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{Binding AccuracyToolTip}">
                                                    <TextBlock Text="{Binding AccuracyText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- The lower metadata row may use the otherwise empty cell below the mod icons. -->
                                        <Grid Grid.Column="2"
                                              Grid.ColumnSpan="2"
                                              Margin="8,0,0,0"
                                              ClipToBounds="True"
                                              IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding DifficultyLine}"
                                                           Style="{StaticResource Text.Muted}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <Button Grid.Column="4" Content="&#8942;" Click="CardOverflow_Click" Style="{StaticResource CompactRowGhostButton}" ToolTip="Actions" />
                                    </Grid>
                                </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                        <Border Grid.Row="0"
                                Background="{DynamicResource Brush.PanelBackground}"
                                Panel.ZIndex="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="360"
                                        Margin="24">
                                <TextBlock Text="{Binding HistoryStatus}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Try refreshing, adjust the filters, or check tracking in Settings &amp; tools."
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Try again" Command="{Binding RefreshCommand}" Style="{StaticResource TopActionButton}" Margin="0,0,8,0" />
                                    <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TopActionButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,1,0,0"
                                Padding="8,6"
                                Visibility="{Binding LoadOlderVisible, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                            <Grid>
                                <TextBlock Text="More history is available"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <Button Content="Load older plays"
                                        Command="{Binding LoadOlderCommand}"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Load older play history">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TopActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingMore}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="Loading older plays…"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding IsLoadingMore, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="MainGridSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- RIGHT: PLAY INSPECTOR -->
            <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.ThemeCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="InspectorHeaderTitle" Text="Selected Play" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="11,0" />
                    </Border>
                    <Button x:Name="InspectorBackButton"
                            Grid.Row="0"
                            Content="&#8592;  Back to history"
                            Click="InspectorBack_Click"
                            Style="{StaticResource TopActionButton}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="6,4"
                            Panel.ZIndex="20"
                            Visibility="Collapsed" />
                    <TextBlock Text="Select an attempt to inspect"
                               Grid.Row="1"
                               Style="{StaticResource Text.Header}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Inspector.ShowEmptyState, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                    <TextBlock Text="Loading..."
                               Grid.Row="1"
                               Style="{StaticResource Text.Header}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding Inspector.IsLoading, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.PanelBackground}"
                            Panel.ZIndex="5"
                            Visibility="{Binding Inspector.HasLoadError, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                            <TextBlock Text="Could not load this play"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Inspector.LoadError}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,14"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <Button Content="Try again"
                                    Command="{Binding Inspector.RetryLoadCommand}"
                                    Style="{StaticResource TopActionButton}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" DataContext="{Binding Inspector}"
                          Visibility="{Binding Details, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- a. header banner -->
                                <Border x:Name="InspectorHero" Height="122" Margin="10,2,10,0" CornerRadius="8" ClipToBounds="True"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                                <Grid ClipToBounds="True">
                                    <Border Background="{DynamicResource Brush.CardBackground}" />
                                    <Border Opacity="0.96"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ArtworkSource}"
                                                        Stretch="UniformToFill"
                                                        AlignmentX="Center"
                                                        AlignmentY="Center" />
                                        </Border.Background>
                                    </Border>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#08000000" Offset="0"/>
                                                <GradientStop Color="#38000000" Offset="0.48"/>
                                                <GradientStop Color="#DB100A0D" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:RankProgressBadge Width="0" Visibility="Collapsed"
                                                                    Height="38"
                                                                    VerticalAlignment="Center"
                                                                    RankText="{Binding Grade}"
                                                                    Progress="{Binding GradeProgress}"
                                                                    AccentBrush="{DynamicResource Brush.AccentPink}"
                                                                    TrackBrush="{DynamicResource Brush.BorderSubtle}"
                                                                    BackgroundBrush="{DynamicResource Brush.CardBackground}"
                                                                    TextBrush="{DynamicResource Brush.TextPrimary}" />
                                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="390"
                                                Margin="0,2,12,0" Padding="10,7"
                                                Background="{DynamicResource Brush.OverlayBackground}"
                                                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MapTitle}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MapArtist}" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding DifficultyName}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,42"
                                                Padding="9,4" Background="{DynamicResource Brush.CardSelectedBackground}"
                                                BorderBrush="{DynamicResource Brush.AccentPurple}" BorderThickness="1" CornerRadius="14">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#9733;" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding StarsNumberDisplay}" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- CS/AR/OD/HP/BPM pinned to the bottom-right of the banner frame -->
                                    <StackPanel Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8">
                                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="CS" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding CsDisplay}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="AR" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ArDisplay}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="OD" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding OdDisplay}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="HP" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding HpDisplay}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="BPM" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BpmDisplay}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Height="32" VerticalAlignment="Bottom" Background="{DynamicResource Brush.OverlayBackground}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MapperLine}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OutcomeDisplay}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PlayedLine}" ToolTip="{Binding StartedLine}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                                </Border>

                                <Border Style="{StaticResource PagePanel}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        Padding="8"
                                        Margin="10,6,10,0">
                                    <UniformGrid Columns="7">
                                        <StackPanel><TextBlock Text="CS" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding CsDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="AR" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ArDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="OD" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding OdDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="HP" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding HpDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="LENGTH" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding TechnicalDuration}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="BPM" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding BpmDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="DIFFICULTY" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding StarsDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentPurple}" Margin="0,3,0,0"/></StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- b. mods/status bar -->
                                <Grid Visibility="Collapsed" Background="{DynamicResource Brush.ControlBackground}" Height="27">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" Visibility="Collapsed" ItemsSource="{Binding Details.Mods}" Margin="12,0,9,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="27"
                                                      Height="21"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}">
                                                    <Polygon Points="2,10.5 7,1 20,1 25,10.5 20,20 7,20"
                                                             Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToBrushConverter.Instance}}" />
                                                    <Rectangle Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToForegroundBrushConverter.Instance}}"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush Stretch="Uniform"
                                                                        ImageSource="{Binding Acronym, Converter={x:Static vm:ModAcronymToIconSourceConverter.Instance}}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="1" Text="{Binding OutcomeUpper}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,9,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutcomeUpper}" Value="COMPLETED">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutcomeUpper}" Value="QUIT">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutcomeUpper}" Value="FAILED">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ModSettingsSummary}" Style="{StaticResource Text.Metadata}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding PpValue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="10,8,10,0"
                                        Padding="10,7"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.CardSelectedBackground}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReplayRecoveredResult}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ReplayRecoveryNotice}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- c/d. primary + secondary bordered stat rows (shared outer border) -->
                                <Border Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="10,8,10,0">
                                    <StackPanel>
                                        <UniformGrid Columns="4">
                                            <Border Style="{StaticResource StatCellPrimary}">
                                                <StackPanel>
                                                    <controls:RankProgressBadge Width="44" Height="44" HorizontalAlignment="Center"
                                                                                RankText="{Binding Grade}" Progress="{Binding GradeProgress}"
                                                                                AccentBrush="{DynamicResource Brush.AccentPink}"
                                                                                TrackBrush="{DynamicResource Brush.BorderSubtle}"
                                                                                BackgroundBrush="{DynamicResource Brush.CardBackground}"
                                                                                TextBrush="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="GRADE" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatCellPrimary}">
                                                <StackPanel>
                                                    <TextBlock Text="ACCURACY" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Text="{Binding AccuracyValue}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccuracyToolTip}" />
                                                     <TextBlock Text="{Binding AccuracyQualifier}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" ToolTip="{Binding AccuracyToolTip}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatCellPrimary}">
                                                <StackPanel>
                                                    <TextBlock Text="SCORE" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ScoreValue}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatCellPrimary}" BorderThickness="0">
                                                <StackPanel>
                                                    <TextBlock Text="MAX COMBO" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ComboValue}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                                            <UniformGrid Columns="7">
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel><TextBlock Text="300" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Cyan}" HorizontalAlignment="Center" ToolTip="GREAT judgement"/><TextBlock Text="{Binding N300Text}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel><TextBlock Text="100" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" ToolTip="OK judgement"/><TextBlock Text="{Binding N100Text}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel><TextBlock Text="50" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" ToolTip="MEH judgement"/><TextBlock Text="{Binding N50Text}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel><TextBlock Text="MISS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center"/><TextBlock Text="{Binding MissCountText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel ToolTip="Slider breaks"><TextBlock Text="SLIDER BREAKS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SliderBreakText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}"><StackPanel ToolTip="Lazer LargeTickHit judgement"><TextBlock Text="LARGE TICK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentPurple}" HorizontalAlignment="Center"/><TextBlock Text="{Binding LargeTickText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource StatCellSecondary}" BorderThickness="0"><StackPanel ToolTip="Lazer SliderTailHit judgement"><TextBlock Text="SLIDER TAIL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SliderTailText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                            </UniformGrid>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                                        <Grid Height="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="MODS" Style="{StaticResource Text.LabelUpper}" FontSize="10" Margin="1,0,0,1" />
                                            <ItemsControl x:Name="SelectedPlayMods"
                                                          ItemsSource="{Binding DisplayMods}"
                                                          Height="36"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          AutomationProperties.Name="Active modifications">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDisplayMods}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="34" Height="36" Margin="0,0,4,0"
                                                              ToolTip="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}"
                                                              ToolTipService.InitialShowDelay="0"
                                                              ToolTipService.BetweenShowDelay="0"
                                                              ToolTipService.ShowDuration="60000"
                                                              ToolTipService.Placement="Top"
                                                              ToolTipService.VerticalOffset="-2"
                                                              AutomationProperties.Name="{Binding Converter={x:Static vm:ModEntryToToolTipConverter.Instance}}">
                                                            <Polygon Points="2,10.5 7,1 20,1 25,10.5 20,20 7,20" Width="27" Height="21" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                     Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToBrushConverter.Instance}}" />
                                                            <Rectangle Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                                                       Fill="{Binding Acronym, Converter={x:Static vm:ModAcronymToForegroundBrushConverter.Instance}}"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush Stretch="Uniform" ImageSource="{Binding Acronym, Converter={x:Static vm:ModAcronymToIconSourceConverter.Instance}}" />
                                                                </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                            <TextBlock Text="{Binding Acronym}"
                                                                       VerticalAlignment="Bottom"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoModsText"
                                                       Text="None"
                                                       Margin="1,4,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       AutomationProperties.Name="No active modifications">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDisplayMods}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1,0" Padding="10,4">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="PP" Style="{StaticResource Text.LabelUpper}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentPpText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="1" Text="FC PP" Style="{StaticResource Text.LabelUpper}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FcPpText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentPink}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="4" Grid.ColumnSpan="2" Margin="8,7">
                                                <UniformGrid Columns="2" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TechnicalKey1Presses}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="K1 PRESSES" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TechnicalKey2Presses}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="K2 PRESSES" Style="{StaticResource Text.LabelUpper}" FontSize="10" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Border>
                                        </Grid>
                                        </Border>

                                        <Expander Header="Additional score data" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="8,4">
                                            <UniformGrid Columns="4" Opacity="{Binding SliderStatsOpacity}" ToolTip="{Binding SliderStatsToolTip}">
                                                <StackPanel><TextBlock Text="PROGRESS" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ProgressValue}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                                <StackPanel><TextBlock Text="UR" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding UrText}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                                <StackPanel><TextBlock Text="SMALL TICK" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SmallTickText}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                                <StackPanel><TextBlock Text="BREAKS" Style="{StaticResource Text.LabelUpper}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SliderBreakText}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                            </UniformGrid>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- e. charts, stacked full width -->
                                <StackPanel x:Name="ScrollableChartsPanel" Margin="10,6,10,0" Visibility="Visible">
                                    <Border Style="{StaticResource ChartPanel}" Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition x:Name="ScrollHitTimingRow" Height="126" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="HIT TIMING"
                                                                   Style="{StaticResource ChartTitle}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TimingHitCountText}"
                                                                   Style="{StaticResource Text.Muted}"
                                                                   FontSize="11"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TimingOverviewText}"
                                                               Style="{StaticResource Text.Muted}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ElementName=ScrollHitTimingGraph, Path=HoverReadout}"
                                                           Foreground="{DynamicResource Brush.AccentPink}"
                                                           FontSize="10"
                                                           VerticalAlignment="Top"
                                                           Margin="10,0,0,0" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <controls:HitTimingGraph x:Name="ScrollHitTimingGraph"
                                                                         Offsets="{Binding TimingOffsets}"
                                                                         Margin="0,0,10,0"
                                                                         Visibility="{Binding HasTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                                <TextBlock Text="No hit-timing samples were captured."
                                                           Style="{StaticResource Text.Muted}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"
                                                           Visibility="{Binding NoTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                        BorderThickness="1,0,0,0"
                                                        Padding="10,0,0,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="0,0,0,4">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="BIAS" Style="{StaticResource Text.LabelUpper}" FontSize="9" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding TimingBiasText}" FontSize="15" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding TimingBiasDirectionText}"
                                                                               FontSize="9"
                                                                               FontWeight="SemiBold"
                                                                               Margin="7,4,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPink}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding TimingBiasDirectionText}" Value="LATE">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPurple}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding TimingBiasDirectionText}" Value="CENTERED">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Row="1"
                                                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="0,3,0,4">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="SPREAD" Style="{StaticResource Text.LabelUpper}" FontSize="9" />
                                                                <TextBlock Text="{Binding TimingSpreadText}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,4,0,0">
                                                            <TextBlock Text="SPLIT" Style="{StaticResource Text.LabelUpper}" FontSize="9" />
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                                                <Run Text="{Binding TimingEarlyCountText, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentPink}" />
                                                                <Run Text=" early  &#x00B7;  " Foreground="{DynamicResource Brush.TextSecondary}" />
                                                                <Run Text="{Binding TimingLateCountText, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentPurple}" />
                                                                <Run Text=" late" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ChartPanel}" Padding="8,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition x:Name="ScrollMapPressureRow" Height="100" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="MOVEMENT / MAP PRESSURE" Style="{StaticResource ChartTitle}" FontSize="10" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ElementName=ScrollMapPressureGraph, Path=HoverReadout}"
                                                               Foreground="{DynamicResource Brush.AccentPink}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <CheckBox Content="UR" IsChecked="{Binding ShowUr}" Style="{StaticResource ChartLegendCheckBox}" Margin="0,0,7,0" />
                                                    <CheckBox Content="Miss" IsChecked="{Binding ShowMiss}" Style="{StaticResource ChartLegendCheckBox}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <controls:MapPressureGraph x:Name="ScrollMapPressureGraph"
                                                                           Details="{Binding Details}"
                                                                           Curve="{Binding PressureCurve}"
                                                                           UrSamples="{Binding UrSamples}"
                                                                           ShowMiss="{Binding ShowMiss}"
                                                                           ShowBreak="{Binding ShowBreak}"
                                                                           ShowUr="{Binding ShowUr}"
                                                                           Margin="0,3,0,0" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="0:00" Style="{StaticResource Text.Metadata}" FontSize="11" />
                                                <TextBlock Text="{Binding PressureEndText}" Style="{StaticResource Text.Metadata}" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Height="8" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- e. pinned bottom charts -->
                        <StackPanel x:Name="PinnedChartsPanel" Grid.Row="1" Margin="10,6,10,6">
                            <Border Style="{StaticResource ChartPanel}" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="70" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="HIT TIMING" Style="{StaticResource ChartTitle}" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UrText, StringFormat=' - UR {0}'}"
                                                   Style="{StaticResource Text.Muted}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                        <TextBlock Text="{Binding ElementName=PinnedHitTimingGraph, Path=HoverReadout, StringFormat=' - {0}'}"
                                                   Foreground="{DynamicResource Brush.AccentPink}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <controls:HitTimingGraph x:Name="PinnedHitTimingGraph"
                                                                 Offsets="{Binding TimingOffsets}" Margin="0,3,0,0"
                                                                 Visibility="{Binding HasTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                        <TextBlock Text="No hit-timing samples were captured." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding NoTimingSamples, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ChartPanel}" Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="120" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="MAP PRESSURE" Style="{StaticResource ChartTitle}" FontSize="10" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=PinnedMapPressureGraph, Path=HoverReadout}"
                                                       Foreground="{DynamicResource Brush.AccentPink}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <CheckBox Content="UR" IsChecked="{Binding ShowUr}" Style="{StaticResource ChartLegendCheckBox}" Margin="0,0,7,0" />
                                            <CheckBox Content="Miss" IsChecked="{Binding ShowMiss}" Style="{StaticResource ChartLegendCheckBox}" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:MapPressureGraph x:Name="PinnedMapPressureGraph"
                                                               Grid.Row="1"
                                                               Details="{Binding Details}"
                                                               Curve="{Binding PressureCurve}"
                                                               UrSamples="{Binding UrSamples}"
                                                               ShowMiss="{Binding ShowMiss}"
                                                               ShowBreak="{Binding ShowBreak}"
                                                               ShowUr="{Binding ShowUr}"
                                                               Margin="0,3,0,0" />
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="0:00" Style="{StaticResource Text.Metadata}" FontSize="11" />
                                        <TextBlock Text="{Binding PressureEndText}" Style="{StaticResource Text.Metadata}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- f. pinned footer -->
                        <Grid Grid.Row="2" Background="{DynamicResource Brush.PanelBackground}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Grid.ColumnSpan="3" />
                            <Expander x:Name="TechnicalDetailsExpander"
                                      Header="Technical details"
                                      IsExpanded="False"
                                      Expanded="TechnicalDetailsExpander_Expanded"
                                      Collapsed="TechnicalDetailsExpander_Collapsed"
                                      Margin="12,4,12,0"
                                      VerticalAlignment="Center">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Expander">
                                                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <DockPanel>
                                                            <ToggleButton x:Name="HeaderSite"
                                                                          DockPanel.Dock="Top"
                                                                          Content="{TemplateBinding Header}"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                          MinHeight="24"
                                                                          Foreground="{DynamicResource Brush.TextSecondary}"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          Padding="0,6"
                                                                          HorizontalContentAlignment="Left">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Grid Background="Transparent">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="18" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Path x:Name="Arrow"
                                                                                  Width="8"
                                                                                  Height="8"
                                                                                  Stretch="Uniform"
                                                                                  Data="M 0 0 L 5 4.5 L 0 9"
                                                                                  Stroke="{DynamicResource Brush.AccentPink}"
                                                                                  StrokeThickness="1.9"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Center">
                                                                                <Path.RenderTransform>
                                                                                    <RotateTransform Angle="0" CenterX="4" CenterY="4" />
                                                                                </Path.RenderTransform>
                                                                            </Path>
                                                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="ExpandSite"
                                                                              Visibility="Collapsed"
                                                                              DockPanel.Dock="Bottom" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Grid Margin="18,3,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding TechnicalAttemptNumber}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding TechnicalSessionNumber}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TechnicalMapLine}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0" />
                                        <Button Grid.Column="2"
                                                Content="Replay Analyzer"
                                                Command="{Binding DataContext.OpenSelectedReplayInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanOpenReplayInspector, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                                                Style="{StaticResource Button.Primary}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Height="27"
                                                MinHeight="27"
                                                MinWidth="118"
                                                Padding="14,0"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.ThemeCard}" Padding="10,9" Background="{DynamicResource Brush.PanelBackground}">
                                        <UniformGrid Columns="3">
                                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,7,0" Background="{DynamicResource Brush.PanelBackground}">
                                                <StackPanel>
                                                    <TextBlock Text="INPUT" Style="{StaticResource Text.LabelUpper}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,0,0,6" />
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="K1 presses" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalKey1Presses}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="K2 presses" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalKey2Presses}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="simultaneous" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalSimultaneous}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="peak" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalPeakKps}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="avg" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalAverageKps}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="hold time K1" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalKey1Hold}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="hold time K2" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalKey2Hold}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="7,0" Background="{DynamicResource Brush.PanelBackground}">
                                                <StackPanel>
                                                    <TextBlock Text="RECORDING" Style="{StaticResource Text.LabelUpper}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,0,0,6" />
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="source" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalRecordingSource}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="samples" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalRecordingSamples}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="sample rate" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalSampleRate}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="dropped" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalDroppedSamples}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="timing samples" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalTimingSamples}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="mean" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalMeanTiming}" Foreground="{DynamicResource Brush.AccentPurple}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="median" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalMedianTiming}" Foreground="{DynamicResource Brush.AccentPurple}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="deviation" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalDeviationTiming}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Button Content=".osr validation"
                                                            Command="{Binding ValidateOsrCommand}"
                                                            Margin="0,10,0,0"
                                                            Height="26"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            ToolTip="Compare this recorded play with an .osr replay">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
                                                                <Setter Property="IsEnabled" Value="{Binding CanValidateOsr}" />
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="7,0,0,0" Background="{DynamicResource Brush.PanelBackground}">
                                                <StackPanel>
                                                    <TextBlock Text="MAP" Style="{StaticResource Text.LabelUpper}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,0,0,6" />
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="duration" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalDuration}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="progress" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalProgress}" Foreground="{DynamicResource Brush.Success}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="screen" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalTermination}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="beatmap id" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalBeatmapId}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="checksum" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalChecksum}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                    <UniformGrid Columns="3" Margin="0,1,0,6">
                                                        <StackPanel><TextBlock Text="Ticks" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Text="{Binding TechnicalTicks}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                                                        <StackPanel><TextBlock Text="Ends" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Text="{Binding TechnicalEnds}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                                                        <StackPanel><TextBlock Text="Breaks" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Text="{Binding TechnicalBreaks}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                                                    </UniformGrid>
                                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                                        <StackPanel><TextBlock Text="K1" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Text="{Binding TechnicalKey1Presses}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                                                        <StackPanel><TextBlock Text="K2" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Text="{Binding TechnicalKey2Presses}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                                                    </UniformGrid>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Judgement events" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TechnicalJudgementEvents}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" /></Grid>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Expander>
                            <Button Grid.Column="2"
                                    Content="Replay Analyzer"
                                    Command="{Binding DataContext.OpenSelectedReplayInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    MinWidth="118"
                                    Height="27"
                                    MinHeight="27"
                                    Margin="0,6,12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                        <Setter Property="Visibility" Value="{Binding CanOpenReplayInspector, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, ElementName=TechnicalDetailsExpander}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Padding="14,10,14,11"
                    Background="{DynamicResource Brush.OverlayBackground}"
                    BorderBrush="{DynamicResource Brush.AccentPink}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsReplayAnalyzerLoading, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                <Grid Width="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ReplayAnalyzerLoadingText}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1"
                                 Height="3"
                                 Margin="0,9,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource Brush.AccentPink}"
                                 Background="#361224"
                                 BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- Dedicated destinations mirror the reference navigation instead of
             filtering the dashboard into pretend pages. -->
        <Grid x:Name="SessionsPage" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="22,18" MaxWidth="1920">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sessions" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Your play sessions, separated from individual play history" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,14" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalContentAlignment="Stretch" Margin="0,0,0,9">
                              <Expander.Header>
                              <Border Style="{StaticResource PagePanel}" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.CardSelectedBackground}" Margin="0,0,13,0">
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="&#9654;" Foreground="{DynamicResource Brush.AccentPink}" HorizontalAlignment="Center"/><TextBlock Text="{Binding TimeText}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateText}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HeaderLine}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatsLine}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="&#8942;" Click="SessionOverflow_Click" Style="{StaticResource CompactRowGhostButton}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                        <StackPanel Width="112"><TextBlock Text="{Binding AttemptCountText}" FontWeight="SemiBold"/><TextBlock Text="PLAYS" Style="{StaticResource Text.LabelUpper}"/></StackPanel>
                                        <StackPanel Width="126"><TextBlock Text="{Binding CompletionText}" FontWeight="SemiBold"/><TextBlock Text="COMPLETION" Style="{StaticResource Text.LabelUpper}"/></StackPanel>
                                        <StackPanel Width="112"><TextBlock Text="{Binding BestPpText}" FontWeight="SemiBold"/><TextBlock Text="BEST" Style="{StaticResource Text.LabelUpper}"/></StackPanel>
                                        <StackPanel Width="112"><TextBlock Text="{Binding AverageUrText}" FontWeight="SemiBold"/><TextBlock Text="TIMING" Style="{StaticResource Text.LabelUpper}"/></StackPanel>
                                        <StackPanel Width="112"><TextBlock Text="{Binding ActiveTimeText}" FontWeight="SemiBold"/><TextBlock Text="ACTIVE" Style="{StaticResource Text.LabelUpper}"/></StackPanel>
                                    </WrapPanel>
                                </Grid>
                              </Border>
                              </Expander.Header>
                              <Border Background="{DynamicResource Brush.PanelBackground}"
                                      BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                      BorderThickness="1,0,1,1"
                                      CornerRadius="0,0,8,8"
                                      Padding="8">
                                <Grid>
                                  <TextBlock Text="{Binding PlaysStatus}" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
                                  <ListBox ItemsSource="{Binding Attempts}"
                                           SelectedItem="{Binding DataContext.SelectedAttempt, RelativeSource={RelativeSource AncestorType=Window}}"
                                           ItemTemplate="{StaticResource PlayCardTemplate}"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           MaxHeight="430"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                           VirtualizingPanel.IsVirtualizing="True"
                                           VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </Grid>
                              </Border>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WorkspacePage" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="16" MaxWidth="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceNavigationColumn" Width="210"/>
                <ColumnDefinition x:Name="WorkspaceGapColumn" Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="WorkspaceNavigationPanel" Style="{StaticResource PagePanel}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings &amp; tools" FontSize="18" FontWeight="SemiBold" Margin="6,4,6,2"/>
                        <TextBlock Text="Everything stays inside Kumori" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="6,0,6,10"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Settings and tools navigation">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="SETTINGS" Style="{StaticResource Text.LabelUpper}" Margin="6,0,0,5"/>
                        <Button Content="Appearance &amp; application" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Setup wizard" Command="{Binding OpenSetupWizardCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Skin library" Command="{Binding OpenSkinLibraryCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="tosu setup" Command="{Binding OpenTosuSetupCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Launch tosu" Command="{Binding LaunchTosuCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="STATUS &amp; MAINTENANCE" Style="{StaticResource Text.LabelUpper}" Margin="6,0,0,5"/>
                        <Button Content="Health dashboard" Command="{Binding OpenHealthDashboardCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Backup &amp; restore" Command="{Binding OpenBackupsCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Data maintenance…" Click="ActionsButton_Click" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Right">
                                    <MenuItem Header="Clear beatmap cache" Command="{Binding ClearBeatmapCacheCommand}" />
                                    <MenuItem Header="Cleanup invalid attempts" Command="{Binding CleanupInvalidAttemptsCommand}" />
                                    <MenuItem Header="Delete short plays…" Command="{Binding DeleteShortPlaysCommand}" />
                                    <Separator />
                                    <MenuItem Header="Delete entries before…" Command="{Binding DeleteEntriesBeforeCommand}" />
                                    <MenuItem Header="Delete all tracking data" Command="{Binding DeleteAllTrackingDataCommand}" Foreground="{DynamicResource Brush.Danger}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="SUPPORT" Style="{StaticResource Text.LabelUpper}" Margin="6,0,0,5"/>
                        <Button Content="Changelog" Command="{Binding OpenChangelogCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Join the Kumori Discord ↗" Click="DiscordNavigation_Click" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5" AutomationProperties.HelpText="Opens an external website"/>
                        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Report a problem" Command="{Binding ExportProblemReportCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Open app folders…" Click="ActionsButton_Click" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Right">
                                    <MenuItem Header="Open logs" Command="{Binding OpenLogsCommand}" />
                                    <MenuItem Header="Open AppData" Command="{Binding OpenAppDataCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />
                        <TextBlock Text="DEVELOPER" Style="{StaticResource Text.LabelUpper}" Margin="6,0,0,5"/>
                        <Button Content="Developer settings" Command="{Binding OpenDeveloperSettingsCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="tosu diagnostics" Command="{Binding OpenTosuDiagnosticsCommand}" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                        <Button Content="Replay capture diagnostics…" Click="ActionsButton_Click" Style="{StaticResource TopActionButton}" HorizontalContentAlignment="Left">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Right">
                                    <MenuItem Header="Lazer frame debug" Command="{Binding OpenLazerFrameDebugCommand}" />
                                    <MenuItem Header="Stable frame debug" Command="{Binding OpenStableFrameDebugCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PagePanel}" Padding="0" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="WorkspaceEmptyText" Text="Choose a settings or tools page" Foreground="{DynamicResource Brush.TextMuted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TabControl x:Name="WorkspaceTabs" Style="{StaticResource WorkspaceTabControl}" Visibility="Collapsed" AutomationProperties.Name="Open settings and tools"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PerformancePage" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="22,18" MaxWidth="1920">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Performance" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Your long-term play quality, consistency and activity" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,12,14"/></StackPanel>
                <Border x:Name="PerformanceScopeBadge" Grid.Column="1" Style="{StaticResource PagePanel}" Padding="12,7" VerticalAlignment="Top"><TextBlock Text="All recorded plays" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></Border>
            </Grid>
            <UniformGrid x:Name="PerformanceMetrics" Grid.Row="1" Columns="4" Margin="-4,0,-4,12">
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TOTAL PLAYS" Style="{StaticResource Text.LabelUpper}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding GlobalAttemptsMetric}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="COMPLETION RATE" Style="{StaticResource Text.LabelUpper}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding GlobalCompletionMetric}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="AVERAGE ACCURACY" Style="{StaticResource Text.LabelUpper}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding GlobalAccuracyMetric}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="BEST PERFORMANCE" Style="{StaticResource Text.LabelUpper}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding GlobalBestPpMetric}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,6,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="COMPLETED" Style="{StaticResource Text.LabelUpper}"/><TextBlock Grid.Row="1" Text="{Binding GlobalCompletedMetric}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="FAILED" Style="{StaticResource Text.LabelUpper}"/><TextBlock Grid.Row="1" Text="{Binding GlobalFailedMetric}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" Margin="0,5,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TOTAL SCORE" Style="{StaticResource Text.LabelUpper}"/><TextBlock Grid.Row="1" Text="{Binding GlobalScoreMetric}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></Grid></Border>
                <Border Style="{StaticResource MetricCellCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PLAY TIME" Style="{StaticResource Text.LabelUpper}"/><TextBlock Grid.Row="1" Text="{Binding GlobalPlaytimeMetric}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></Grid></Border>
            </UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource PagePanel}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="16,14,16,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Daily performance" Style="{StaticResource PageSectionTitle}"/><TextBlock Text="All recorded days · select a day to show every play" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Account changes use the prior recorded day" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" VerticalAlignment="Center"/></Grid>
                    <Grid Grid.Row="1" Height="28" Background="{DynamicResource Brush.ControlBackground}" Margin="1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="DATE" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="PLAYS" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="COMPLETION" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="AVG ACC" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="BEST PP" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="PP Δ" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="RANK Δ" Style="{StaticResource Text.LabelUpper}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,5" AutomationProperties.Name="Daily performance history">
                        <ItemsControl ItemsSource="{Binding PerformanceDays}" Focusable="False" IsTabStop="False" AutomationProperties.Name="Daily performance entries">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Margin="0,0,0,5">
                                        <Expander.Header>
                                            <Border Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="6" Padding="8,7">
                                                <Grid Height="50">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding DateText}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding DayText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PlaysText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding CompletedText, StringFormat={}{0} done}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                    <Grid Grid.Column="2" Margin="0,4,12,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding CompletionText}" FontSize="11" FontWeight="SemiBold"/><ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CompletionRate}" Height="4" Margin="0,5,0,0" Foreground="{DynamicResource Brush.Success}" Background="{DynamicResource Brush.ControlBackground}" BorderThickness="0" AutomationProperties.Name="Completion rate"/></Grid>
                                                    <TextBlock Grid.Column="3" Text="{Binding AccuracyText}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding BestPpText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding PpChangeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentPink}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding RankChangeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Cyan}" FontSize="11" FontWeight="SemiBold" Margin="0,0,7,0" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </Expander.Header>
                                        <Border Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,7,7" Padding="6">
                                            <Grid>
                                                <TextBlock Text="{Binding PlaysStatus}" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                                                <ListBox ItemsSource="{Binding Attempts}"
                                                         SelectedItem="{Binding DataContext.SelectedAttempt, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         ItemTemplate="{StaticResource PlayCardTemplate}"
                                                         Style="{StaticResource HistoryListBox}"
                                                         ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                                                         MaxHeight="520"
                                                         Background="Transparent"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"/>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.RowSpan="3" Background="{DynamicResource Brush.PanelBackground}" Visibility="{Binding HasNoPerformanceData, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><TextBlock Text="No performance data yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Complete a tracked osu!standard play to start building daily performance trends." FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,14"/><Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TopActionButton}" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="MapsPage" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="22,18" MaxWidth="1920">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Maps" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Your most-played beatmaps and performance averages" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel>
                <Border x:Name="MapsSortBadge" Grid.Column="1" Style="{StaticResource PagePanel}" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="Sorted by play count" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></Border>
            </Grid>
            <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding MapRows}" MaxWidth="1120" Background="Transparent" BorderThickness="0"
                     Focusable="False" IsTabStop="False" AutomationProperties.Name="Recorded maps"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Click="MapCard_Click" Height="160" Padding="0" Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ToolTip="Show every recorded play on this map" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="Show every recorded play on this map">
                        <Border Style="{StaticResource PagePanel}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border CornerRadius="8,8,0,0" ClipToBounds="True" Background="{DynamicResource Brush.CardSelectedBackground}">
                                    <Grid>
                                        <Image Source="{Binding ArtworkSource, Converter={x:Static vm:PanelArtworkSourceConverter.Instance}}" Stretch="UniformToFill" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Background="#8A09070B"/>
                                        <Grid Margin="12,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                <TextBlock Margin="0,4,0,0" FontSize="10.5" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Artist, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    <Run Text="  ·  " Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    <Run Text="{Binding Difficulty, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentPink}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource Brush.CardSelectedBackground}" BorderBrush="{DynamicResource Brush.AccentPink}" BorderThickness="1" CornerRadius="11" Padding="8,3" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PlayCountText}" FontWeight="SemiBold" FontSize="10.5"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <UniformGrid Columns="3" Margin="12,8,12,4">
                                        <StackPanel ToolTip="{Binding AverageLine}">
                                            <TextBlock Text="AVERAGE" Style="{StaticResource Text.LabelUpper}"/>
                                            <TextBlock Text="{Binding AveragePerformanceText}" Margin="0,5,6,0" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel ToolTip="{Binding BestLine}">
                                            <TextBlock Text="BEST" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}"/>
                                            <TextBlock Text="{Binding BestPerformanceText}" Margin="0,5,6,0" Foreground="{DynamicResource Brush.AccentPink}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel ToolTip="Best recorded combo / beatmap maximum combo">
                                            <TextBlock Text="BEST COMBO" Style="{StaticResource Text.LabelUpper}"/>
                                            <TextBlock Text="{Binding ComboText}" Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Grid Grid.Row="1" Margin="12,0,12,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding CompletionText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CompletionRate, Mode=OneWay}" Height="3" Margin="0,5,0,0" Foreground="{DynamicResource Brush.Success}" Background="{DynamicResource Brush.ControlBackground}" BorderThickness="0" AutomationProperties.Name="Completion rate"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding LastPlayed}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
                <Border Background="{DynamicResource Brush.AppBackground}" Visibility="{Binding HasNoMapData, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><TextBlock Text="No maps recorded yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Enable play tracking and play an osu!standard map to populate map statistics." FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,14"/><Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TopActionButton}" HorizontalAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="OnboardingOverlay"
              Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="200"
              Background="{DynamicResource Brush.AppBackground}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="Collapsed">
            <Border Margin="18"
                    MaxWidth="1180"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.AppBackground}"
                    BorderBrush="{DynamicResource Brush.SubtleBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ContentControl x:Name="OnboardingHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
            <Border x:Name="OnboardingToolLayer"
                    Panel.ZIndex="2"
                    Margin="18"
                    MaxWidth="1180"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.AppBackground}"
                    BorderBrush="{DynamicResource Brush.SubtleBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.PanelBackground}">
                        <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="←  Back to setup" Click="OnboardingToolBack_Click" Style="{StaticResource TopActionButton}" Padding="11,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnboardingToolTitle" Grid.Column="1" Text="Tool" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,90,0"/>
                        </Grid>
                    </Border>
                    <ContentControl x:Name="OnboardingToolHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
