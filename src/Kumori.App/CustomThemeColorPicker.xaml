<UserControl x:Class="Kumori.App.CustomThemeColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="336"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="PickerSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.TextPrimary}"
                                                        BorderBrush="{DynamicResource Brush.AppBackground}"
                                                        BorderThickness="2"
                                                        CornerRadius="6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="14"
            CornerRadius="10"
            Background="{DynamicResource Brush.PanelBackground}"
            BorderBrush="{DynamicResource Brush.StrongBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RoleTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock x:Name="RoleDescription" Margin="0,2,8,0" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
                <Button Grid.Column="1" Width="26" Height="26" Padding="0" Content="×" Click="Close_Click" ToolTip="Close picker" />
            </Grid>

            <Grid x:Name="SaturationValuePlane"
                  Height="176"
                  Cursor="Cross"
                  ClipToBounds="True"
                  MouseLeftButtonDown="Plane_MouseLeftButtonDown"
                  MouseMove="Plane_MouseMove"
                  MouseLeftButtonUp="Plane_MouseLeftButtonUp">
                <Border x:Name="HueSurface" CornerRadius="5" Background="#FFFF0000" />
                <Border CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFFFFFFF" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="PlaneMarker"
                             Width="14" Height="14"
                             Stroke="White" StrokeThickness="2"
                             Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.9" Color="#000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <TextBlock Text="Hue" Margin="0,10,0,4" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
            <Grid Height="18">
                <Border Margin="5,5" CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Style="{StaticResource PickerSlider}" ValueChanged="HueSlider_ValueChanged" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" />
            </Grid>

            <TextBlock Text="Opacity" Margin="0,9,0,4" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
            <Grid Height="18">
                <Border Margin="5,5" CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" />
                            <GradientStop x:Name="OpacityGradientStop" Color="#FFFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="255" Style="{StaticResource PickerSlider}" ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" />
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedColourPreview" Width="34" CornerRadius="5" BorderBrush="{DynamicResource Brush.StrongBorder}" BorderThickness="1" />
                <TextBox x:Name="HexValue" Grid.Column="1" Margin="8,0" TextChanged="HexValue_TextChanged" />
                <TextBlock x:Name="OpacityValue" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
