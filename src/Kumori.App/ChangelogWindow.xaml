<Window x:Class="Kumori.App.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kumori Changelog"
        Width="760" Height="720"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="ChangeBullet">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="{DynamicResource Brush.AccentPink}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="17"
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="20,17" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="CHANGELOG" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}" />
                <TextBlock Text="What changed in Kumori" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="Bundled release history · available without an internet connection"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ReleaseList" Margin="18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,13" Padding="16"
                                Background="{DynamicResource Brush.PanelBackground}"
                                BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.ThemeCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Version, StringFormat=Kumori {0}}" FontSize="17" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Padding="9,4" CornerRadius="11"
                                            Background="{DynamicResource Brush.ControlBackground}"
                                            BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1">
                                        <TextBlock Text="{Binding Date}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                </Grid>

                                <Border Padding="12" Margin="0,0,0,10" CornerRadius="{DynamicResource Radius.ThemeCard}"
                                        Background="{DynamicResource Brush.CardSelectedBackground}"
                                        BorderBrush="{DynamicResource Brush.AccentPink}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Major.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="MAJOR" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Major}" ItemTemplate="{StaticResource ChangeBullet}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,2,0,8">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Features.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="FEATURES" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.Cyan}" Margin="0,0,0,3" />
                                    <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource ChangeBullet}" />
                                </StackPanel>
                                <StackPanel Margin="0,2,0,8">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Improvements.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="IMPROVEMENTS" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPurple}" Margin="0,0,0,3" />
                                    <ItemsControl ItemsSource="{Binding Improvements}" ItemTemplate="{StaticResource ChangeBullet}" />
                                </StackPanel>
                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Fixes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="FIXES" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,3" />
                                    <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource ChangeBullet}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Danger}" />
        </Grid>
    </Grid>
</Window>
