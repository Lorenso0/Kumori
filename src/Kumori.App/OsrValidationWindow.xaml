<Window x:Class="Kumori.App.OsrValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kumori.App.ViewModels"
        Title=".osr validation" Width="660" SizeToContent="Height" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Border Margin="1" Padding="24" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="5">
        <StackPanel>
            <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text=".OSR VALIDATION" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}"/><TextBlock Text="{Binding Verdict}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="recording confidence" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/><TextBlock Text="{Binding ConfidenceText}" Foreground="{DynamicResource Brush.AccentPink}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></DockPanel>
            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding ReplayIdentityText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,-9,0,14"/>
            <Border Padding="12" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,12"><StackPanel><TextBlock Text="MAP VERIFICATION" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}"/><TextBlock Text="{Binding ChecksumMatches, StringFormat=Beatmap checksum match: {0}}" FontSize="14" Margin="0,6,0,0"/></StackPanel></Border>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="REPLAY ACCURACY" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/><TextBlock Text="{Binding ReplayAccuracyText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding AccuracyComparisonText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="REPLAY SCORE" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/><TextBlock Text="{Binding ReplayScoreText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ScoreComparisonText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="REPLAY COMBO" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/><TextBlock Text="{Binding ReplayComboText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ComboComparisonText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
            </Grid>
            <Border Padding="12" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="5" Margin="0,2,0,14" Visibility="{Binding HasComparison, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"><StackPanel><TextBlock Text="REPLAY MOVEMENT COMPARISON" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,0,0,8"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="CURSOR ERROR" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Comparison.MedianErrorText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Comparison.P95ErrorText, StringFormat=95th percentile {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="CLICK PRESSES" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Comparison.ClickMatchText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Comparison.AlignmentText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="CURSOR SAMPLES" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Comparison.CoverageText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Comparison.MeanErrorText, StringFormat=mean error {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel></UniformGrid></StackPanel></Border>
            <TextBlock Text="JUDGEMENTS" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}" Margin="0,2,0,7"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="300" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Text="{Binding Replay300}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Recorded300, StringFormat=recorded {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="100" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Text="{Binding Replay100}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Recorded100, StringFormat=recorded {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="50" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Text="{Binding Replay50}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Recorded50, StringFormat=recorded {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="MISS" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Text="{Binding ReplayMisses}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedMisses, StringFormat=recorded {0}}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel>
            </Grid>
            <Border Padding="12" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="5" Margin="0,18,0,14"><StackPanel><TextBlock Text="KUMORI RECORDING" Style="{StaticResource Text.LabelUpper}" Foreground="{DynamicResource Brush.AccentPink}"/><TextBlock Text="{Binding CaptureText}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="Accuracy and judgement data are decoded by osu!lazer's official .osr decoder, including modern replay score data." Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
            <Button Content="Close" IsDefault="True" IsCancel="True" Width="90" HorizontalAlignment="Right" Style="{StaticResource Button.Primary}" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
