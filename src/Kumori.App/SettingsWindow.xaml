<Window x:Class="Kumori.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kumori.App"
        Title="Kumori Settings"
        Width="720" Height="680"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ThemeCard}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsFieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusBorder" MinHeight="32" Padding="4,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="18" Height="18" VerticalAlignment="Center" Background="{DynamicResource Brush.ControlBackground}" BorderBrush="{DynamicResource Brush.StrongBorder}" BorderThickness="1" CornerRadius="3">
                                    <Path x:Name="Check" Width="10" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0.75 4 L 3.6 6.75 L 9.25 0.75" Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="Background" Value="{DynamicResource Brush.ControlHoverBackground}" />
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeCardRadioButton" TargetType="RadioButton">
            <Setter Property="Width" Value="152"/><Setter Property="Height" Value="132"/><Setter Property="Margin" Value="0,0,8,10"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardFrame" Padding="10" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <Border x:Name="SelectedIndicator" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Background="{DynamicResource Brush.AccentPink}" CornerRadius="10" Visibility="Collapsed">
                                    <Path Width="10" Height="8" Data="M 0.75 4 L 3.6 6.75 L 9.25 0.75" Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFrame" Property="Background" Value="{DynamicResource Brush.CardHoverBackground}"/><Setter TargetName="CardFrame" Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CardFrame" Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}"/><Setter TargetName="CardFrame" Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}"/><Setter TargetName="CardFrame" Property="BorderThickness" Value="2"/><Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFrame" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}"/><Setter TargetName="CardFrame" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomColorRowCard" TargetType="Border">
            <Setter Property="MinHeight" Value="68"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="9"/><Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.CardHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPurple}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.CardSelectedBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPink}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Companion automation, replay viewer, tracking, media, and startup." Style="{StaticResource Text.Metadata}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="Changes are kept when you choose Save." Style="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="14,16,10,16">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Choose a visual style. The preview applies immediately across every open Kumori window."
                                   Style="{StaticResource SettingsHint}" />
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton x:Name="RefinedTheme"
                                         GroupName="Theme"
                                         Tag="refined-kumori"
                                         Checked="Theme_Checked"
                                         Style="{StaticResource ThemeCardRadioButton}"
                                         AutomationProperties.Name="Refined Kumori theme"
                                         AutomationProperties.HelpText="Burgundy, pink, and crisp data surfaces">
                                <StackPanel>
                                    <Border Height="40" CornerRadius="6" BorderBrush="#FF2DA8" BorderThickness="1" Background="#20101A">
                                        <Border Margin="8" Background="#351027" CornerRadius="4" />
                                    </Border>
                                    <TextBlock Text="Refined Kumori" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Burgundy, pink, and crisp data surfaces" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PulseTheme"
                                         GroupName="Theme"
                                         Tag="pulse"
                                         Checked="Theme_Checked"
                                         Style="{StaticResource ThemeCardRadioButton}"
                                         AutomationProperties.Name="Pulse theme"
                                         AutomationProperties.HelpText="Energetic, rounded, and artwork-forward">
                                <StackPanel>
                                    <Border Height="40" CornerRadius="10" BorderBrush="#FF4EB8" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#51225E"/><GradientStop Color="#20102D" Offset="1"/></LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Pulse" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Energetic, rounded, and artwork-forward" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FluentTheme"
                                         GroupName="Theme"
                                         Tag="windows-fluent"
                                         Checked="Theme_Checked"
                                         Style="{StaticResource ThemeCardRadioButton}"
                                         AutomationProperties.Name="Windows Fluent theme"
                                         AutomationProperties.HelpText="Layered charcoal and native restraint">
                                <StackPanel>
                                    <Border Height="40" CornerRadius="8" BorderBrush="#4B4C53" BorderThickness="1" Background="#292A2F">
                                        <Border Margin="8" Background="#3A2B35" CornerRadius="5" />
                                    </Border>
                                    <TextBlock Text="Windows Fluent" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Layered charcoal and native restraint" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CustomTheme"
                                         GroupName="Theme"
                                         Tag="custom"
                                         Checked="Theme_Checked"
                                         Style="{StaticResource ThemeCardRadioButton}"
                                         AutomationProperties.Name="Custom theme"
                                         AutomationProperties.HelpText="Use your own shareable color palette">
                                <StackPanel>
                                    <Border Height="40" CornerRadius="8" BorderBrush="{DynamicResource Brush.StrongBorder}" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource Color.AccentPink}" />
                                                <GradientStop Color="{DynamicResource Color.AccentPurple}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Custom" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Your own shareable color palette" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>

                        <Border x:Name="CustomThemeEditor"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Padding="12"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.ControlBackground}"
                                BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <Label Content="Theme name" Target="{Binding ElementName=CustomThemeName}" Style="{StaticResource SettingsFieldLabel}" />
                                    <TextBox x:Name="CustomThemeName" MaxLength="80" AutomationProperties.Name="Custom theme name" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Import" Click="ImportTheme_Click" Margin="0,0,8,0" AutomationProperties.Name="Import custom theme" />
                                        <Button Content="Export" Click="ExportTheme_Click" Margin="0,0,8,0" AutomationProperties.Name="Export custom theme" />
                                        <Button Content="Reset" Click="ResetTheme_Click" AutomationProperties.Name="Reset custom theme" />
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="Choose a role below, then use Kumori's color picker or enter #RRGGBB / #AARRGGBB. Every change previews immediately; Save keeps it."
                                           Style="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Border Height="176"
                                        Margin="0,0,0,14"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Brush.AppBackground}"
                                        BorderBrush="{DynamicResource Brush.StrongBorder}"
                                        BorderThickness="1"
                                        AutomationProperties.Name="Custom theme preview">
                                    <Grid x:Name="ThemePreviewRoot">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PreviewNavigation" Background="{DynamicResource Brush.NavigationBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,1,0">
                                            <StackPanel Margin="10">
                                                <Border x:Name="PreviewPrimaryAccent" Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="15" Background="{DynamicResource Brush.AccentPink}" />
                                                <Border x:Name="PreviewSecondaryAccent" Width="28" Height="5" HorizontalAlignment="Left" Margin="1,14,0,0" CornerRadius="2" Background="{DynamicResource Brush.AccentPurple}" />
                                                <Border x:Name="PreviewCyan" Width="22" Height="5" HorizontalAlignment="Left" Margin="1,8,0,0" CornerRadius="2" Background="{DynamicResource Brush.Cyan}" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border x:Name="PreviewTopBar" Background="{DynamicResource Brush.TopBarBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                                    <TextBlock x:Name="PreviewPrimaryText" Text="Kumori preview" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock x:Name="PreviewMutedText" Text="  live theme" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PreviewPanel" Grid.Row="1" Margin="10" Padding="9" CornerRadius="6" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,9,0">
                                                        <Border x:Name="PreviewSelectedCard" Padding="8" CornerRadius="5" Background="{DynamicResource Brush.CardSelectedBackground}" BorderBrush="{DynamicResource Brush.StrongBorder}" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock x:Name="PreviewSecondaryText" Text="Selected play" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Border x:Name="PreviewSuccess" Background="{DynamicResource Brush.Success}" CornerRadius="3" Padding="5,2" Margin="0,0,4,0"><TextBlock Text="300" FontSize="10" Foreground="{DynamicResource Brush.AppBackground}"/></Border>
                                                                    <Border x:Name="PreviewWarning" Background="{DynamicResource Brush.Warning}" CornerRadius="3" Padding="5,2" Margin="0,0,4,0"><TextBlock Text="50" FontSize="10" Foreground="{DynamicResource Brush.AppBackground}"/></Border>
                                                                    <Border x:Name="PreviewDanger" Background="{DynamicResource Brush.Danger}" CornerRadius="3" Padding="5,2"><TextBlock Text="MISS" FontSize="10" Foreground="{DynamicResource Brush.AppBackground}"/></Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="PreviewHoverCard" Height="24" Margin="0,6,0,0" CornerRadius="4" Background="{DynamicResource Brush.CardHoverBackground}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <Border x:Name="PreviewMetric" Height="34" CornerRadius="5" Background="{DynamicResource Brush.MetricBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1">
                                                            <TextBlock Text="98.42%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                        </Border>
                                                        <Border x:Name="PreviewControl" Height="26" Margin="0,6,0,0" CornerRadius="4" Background="{DynamicResource Brush.ControlBackground}" BorderBrush="{DynamicResource Brush.StrongBorder}" BorderThickness="1">
                                                            <TextBlock Text="Button" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                        </Border>
                                                        <Border x:Name="PreviewHoverControl" Height="18" Margin="0,6,0,0" CornerRadius="4" Background="{DynamicResource Brush.ControlHoverBackground}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="PreviewOverlay" Grid.RowSpan="2" Width="48" Height="30" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5" Background="{DynamicResource Brush.OverlayBackground}" />
                                        </Grid>
                                        <Canvas x:Name="ThemePreviewHighlightLayer" Grid.ColumnSpan="2" IsHitTestVisible="False">
                                            <Border x:Name="ThemePreviewHighlight" Visibility="Collapsed" CornerRadius="5" BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="2" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="PreviewSelectionTitle" Text="Select a color role" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock x:Name="PreviewSelectionDescription" Text="The matching element is outlined in the live preview. Press Enter or Space on a color row to open the picker." Style="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Height="340"
                                        Margin="0,0,0,8"
                                        Padding="8,0,2,0"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.PanelBackground}"
                                        BorderBrush="{DynamicResource Brush.SubtleBorder}"
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="ThemeColorScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="ThemeColorScroll_PreviewMouseWheel">
                                <ItemsControl x:Name="CustomColorList">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Margin="0,9,0,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                            <GroupStyle.Panel>
                                                 <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                            </GroupStyle.Panel>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                             <Border Style="{StaticResource CustomColorRowCard}"
                                                     Focusable="True"
                                                     KeyboardNavigation.IsTabStop="True"
                                                     MouseLeftButtonUp="CustomColorRow_MouseLeftButtonUp"
                                                     KeyDown="CustomColorRow_KeyDown"
                                                     GotKeyboardFocus="CustomColorRow_GotKeyboardFocus"
                                                     AutomationProperties.Name="{Binding Label}"
                                                     AutomationProperties.HelpText="{Binding Description}">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,8,0" />
                                                    </StackPanel>
                                                     <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="{Binding Swatch}" BorderBrush="{DynamicResource Brush.StrongBorder}" Click="CustomSwatch_Click" ToolTip="Open color picker" AutomationProperties.Name="{Binding Label, StringFormat={}{0} color picker}" />
                                                     <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="CustomColor_TextChanged" Margin="6,0,0,0" VerticalAlignment="Center" PreviewMouseDown="CustomHex_PreviewMouseDown" AutomationProperties.Name="{Binding Label, StringFormat={}{0} hex color}" AutomationProperties.HelpText="Enter a color as #RRGGBB or #AARRGGBB" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    </ScrollViewer>
                                 </Border>
                                <Border x:Name="CustomThemeContrastWarningPanel"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.ControlBackground}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="CustomThemeContrastWarning"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Border>
                                <TextBlock x:Name="CustomThemeError"
                                            Foreground="{DynamicResource Brush.Danger}"
                                            FontSize="11"
                                            TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text=".kumori files" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Kumori registers itself as the per-user handler for portable shared plays. Windows keeps the final default-app choice under your control."
                                   Style="{StaticResource SettingsHint}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="KumoriAssociationStatus"
                                   Margin="0,2,0,10"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Content="Repair association" Click="RepairKumoriAssociation_Click" Margin="0,0,8,8" />
                            <Button Content="Windows default apps" Click="OpenDefaultApps_Click" Margin="0,0,8,8" />
                            <Button Content="Remove association" Click="RemoveKumoriAssociation_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Companion Automation" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Controls optional helpers managed by Kumori." Style="{StaticResource SettingsHint}" />

                        <CheckBox x:Name="OtdAutoLaunch" Content="Run OpenTabletDriver while Kumori is open" />
                        <Label Content="OpenTabletDriver executable" Target="{Binding ElementName=OtdPath}" Style="{StaticResource SettingsFieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OtdPath" AutomationProperties.Name="OpenTabletDriver executable path" />
                            <Button Grid.Column="1" Content="Browse" Click="BrowseOtd_Click" Margin="8,0,0,0" AutomationProperties.Name="Browse for OpenTabletDriver" />
                            <Button Grid.Column="2" Content="Detect" Click="DetectOtd_Click" Margin="8,0,0,0" AutomationProperties.Name="Detect OpenTabletDriver" />
                        </Grid>

                        <CheckBox x:Name="DualModeEnabled" Content="Switch LG monitor dual mode automatically" />
                        <CheckBox x:Name="SuspendOsuDuringDualModeSwitch"
                                  Content="Pause osu! while the display mode changes"
                                  Margin="0,4,0,0" />
                        <TextBlock Text="Uses Kumori's built-in DDC/CI command. This option works only with compatible LG monitors." Style="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Replay Viewer" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Native replay playback, skins, audio mix, and visual timing durations." Style="{StaticResource SettingsHint}" />
                        <StackPanel Margin="0,0,0,4">
                            <CheckBox x:Name="ReplayEnabled" Content="Enable native replay viewer" />
                            <CheckBox x:Name="DisableHidden" Content="Disable Hidden mod in viewer" />
                        </StackPanel>

                        <Label Content="Skin path" Target="{Binding ElementName=SkinPath}" Style="{StaticResource SettingsFieldLabel}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SkinPath" AutomationProperties.Name="Replay viewer skin path" />
                            <Button Grid.Column="1" Content="Browse" Click="BrowseSkin_Click" Margin="8,0,0,0" AutomationProperties.Name="Browse for replay viewer skin" />
                            <Button Grid.Column="2" Content="Clear" Click="ClearSkin_Click" Margin="8,0,0,0" AutomationProperties.Name="Use built-in replay viewer skin" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Skin library" Click="SkinLibrary_Click" Margin="0,0,8,0" />
                            <Button Content="Delete imported skin" Click="DeleteSkin_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Tracking And Capture" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Controls what Kumori stores while you play." Style="{StaticResource SettingsHint}" />
                        <StackPanel>
                            <CheckBox x:Name="TrackingEnabled" Content="Log plays with tosu metadata" />
                            <CheckBox x:Name="LazerReplayFrameEnabled" Content="Capture osu! replay frames (stable and lazer)" />
                            <CheckBox x:Name="RunAtLogin" Content="Run Kumori when Windows starts" />
                            <CheckBox x:Name="StartMinimized"
                                      Content="Start minimized to tray"
                                      IsEnabled="{Binding IsChecked, ElementName=RunAtLogin}" />
                        </StackPanel>
                        <Label Content="Minimum play duration (seconds)" Target="{Binding ElementName=MinimumAttemptSeconds}" Style="{StaticResource SettingsFieldLabel}" />
                        <TextBox x:Name="MinimumAttemptSeconds" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="Whole seconds from 1 to 300. Shorter plays are not saved." AutomationProperties.Name="Minimum play duration in seconds" AutomationProperties.HelpText="Enter a whole number from 1 to 300" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock Text="Performance history" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Kumori keeps performance and play history indefinitely. You can manually clear entries older than a chosen age here." Style="{StaticResource SettingsHint}" TextWrapping="Wrap" />
                        <Label Content="Delete data older than (days)" Target="{Binding ElementName=CleanupAgeDays}" Style="{StaticResource SettingsFieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CleanupAgeDays" Width="120" IsEditable="True" AutomationProperties.Name="Age of performance data to delete" AutomationProperties.HelpText="Choose a common age or enter a whole number from 1 to 36500">
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="90" />
                                <ComboBoxItem Content="180" />
                                <ComboBoxItem Content="365" />
                            </ComboBox>
                            <Button x:Name="DeleteOldTrackingData" Content="Delete older data" Click="DeleteOldTrackingData_Click" Margin="8,0,0,0" AutomationProperties.Name="Delete old performance data" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Media" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Beatmap media mirror used for cached artwork and map files." Style="{StaticResource SettingsHint}" />
                        <Label Content="Primary mirror" Target="{Binding ElementName=PrimaryMirror}" Style="{StaticResource SettingsFieldLabel}" />
                        <TextBox x:Name="PrimaryMirror" AutomationProperties.Name="Primary beatmap media mirror" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Backups" Style="{StaticResource SettingsTitle}" />
                        <TextBlock Text="Create rotating local snapshots of tracking data and settings." Style="{StaticResource SettingsHint}" />
                        <CheckBox x:Name="AutomaticBackups" Content="Create automatic backups" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <Label Content="Interval hours" Target="{Binding ElementName=BackupInterval}" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox x:Name="BackupInterval" AutomationProperties.Name="Automatic backup interval in hours" AutomationProperties.HelpText="Enter a whole number from 1 to 720" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Label Content="Backups to keep" Target="{Binding ElementName=BackupRetention}" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox x:Name="BackupRetention" AutomationProperties.Name="Number of automatic backups to keep" AutomationProperties.HelpText="Enter a whole number from 1 to 365" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Custom backup directory (blank uses the Kumori data folder)" Target="{Binding ElementName=BackupDirectory}" Style="{StaticResource SettingsFieldLabel}" />
                        <TextBox x:Name="BackupDirectory" AutomationProperties.Name="Custom backup directory" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="9,7" CornerRadius="5" Background="{DynamicResource Brush.ControlBackground}" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="1">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" AutomationProperties.Name="Cancel settings changes" />
                    <Button Content="Save" Click="Save_Click" IsDefault="True" Style="{StaticResource Button.Primary}" AutomationProperties.Name="Save settings changes" />
                </StackPanel>
            </Grid>
        </Border>
        <Popup x:Name="CustomColorPickerPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="-150" VerticalOffset="5">
            <local:CustomThemeColorPicker x:Name="IntegratedColorPicker" />
        </Popup>
    </Grid>
</Window>
