<Window x:Class="Kumori.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kumori Setup"
        Width="720" Height="580"
        MinWidth="440" MinHeight="420"
        Background="{DynamicResource Brush.AppBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Kumori setup">
    <Window.Resources>
        <Style x:Key="SetupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SetupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="SetupHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="SetupRoot" Background="{DynamicResource Brush.AppBackground}" PreviewKeyDown="SetupRoot_PreviewKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="18,13,18,12" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle" Text="Set up Kumori" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
                <Border Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource Brush.CardSelectedBackground}" BorderBrush="{DynamicResource Brush.AccentPink}" BorderThickness="1" CornerRadius="13" Padding="11,5" VerticalAlignment="Center"><TextBlock x:Name="StepCounter" Text="STEP 1 OF 6" FontSize="10" FontWeight="SemiBold" AutomationProperties.HelpText="Setup progress" AutomationProperties.LiveSetting="Polite"/></Border>
                <TextBlock x:Name="HeaderSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Text="A few quick checks, then you are ready to play." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </Grid>
        </Border>
        <ProgressBar x:Name="StepProgress" Grid.Row="1" Minimum="0" Maximum="6" Value="1" BorderThickness="0" Foreground="{DynamicResource Brush.AccentPink}" Background="{DynamicResource Brush.ControlBackground}" AutomationProperties.Name="Setup progress"/>

        <ScrollViewer x:Name="StepScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14" Focusable="False">
            <Grid>
                <Grid x:Name="WelcomeStep">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeHeading" Text="Welcome to Kumori" Style="{StaticResource SetupTitle}"/>
                        <TextBlock Text="Kumori records your osu! sessions locally, presents detailed play analysis, and runs quietly from the system tray. It does not modify your osu! installation or upload your play data." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><StackPanel><TextBlock Text="What Kumori sets up" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="• Managed tosu metadata tracking&#10;• Replay-frame capture for detailed analysis&#10;• Optional OpenTabletDriver and Windows startup integration" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" LineHeight="22" Margin="0,9,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource SetupCard}" Background="{DynamicResource Brush.CardSelectedBackground}"><TextBlock Text="Your existing osu! files, scores, skins, and settings remain untouched." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}"/></Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SystemStep" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SystemHeading" Text="System check" Style="{StaticResource SetupTitle}"/>
                        <TextBlock Text="These checks update live. An offline tracker while osu! is closed is normal." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="osu! client" FontWeight="SemiBold"/><TextBlock Text="Process and companion detection" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="OsuStatus" Grid.Column="1" Style="{StaticResource StatusValue}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Managed tosu" FontWeight="SemiBold"/><TextBlock Text="Provides live play metadata" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="TosuStatus" Grid.Column="1" Style="{StaticResource StatusValue}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Tracking storage" FontWeight="SemiBold"/><TextBlock Text="Local statistics database" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="StorageStatus" Grid.Column="1" Style="{StaticResource StatusValue}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Replay capture" FontWeight="SemiBold"/><TextBlock Text="Detailed movement and replay analysis" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="CaptureStatus" Grid.Column="1" Style="{StaticResource StatusValue}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Grid></Border>
                        <Button Content="Refresh checks" Click="RefreshChecks_Click" HorizontalAlignment="Left" Padding="14,5" AutomationProperties.Name="Refresh system checks"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TrackingStep" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TrackingHeading" Text="Play tracking" Style="{StaticResource SetupTitle}"/>
                        <TextBlock Text="Kumori manages its own vanilla tosu installation and launches it when osu! starts." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><StackPanel><CheckBox x:Name="TrackingEnabled" Content="Enable play tracking" FontWeight="SemiBold" AutomationProperties.Name="Enable play tracking"/><TextBlock Text="Required for session history, map statistics, PP and judgement data." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="18,5,0,0"/><Grid Margin="18,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Minimum play duration" FontWeight="SemiBold"/><TextBlock Text="Plays shorter than this are ignored (1–300 seconds)." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel><TextBox x:Name="MinimumAttemptSeconds" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="Whole seconds from 1 to 300" AutomationProperties.Name="Minimum play duration in seconds" AutomationProperties.HelpText="Enter a whole number from 1 to 300."/></Grid></StackPanel></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Managed tosu installation" FontWeight="SemiBold"/><TextBlock x:Name="TrackingTosuDetail" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel><Button x:Name="InstallTosuButton" Grid.Column="1" Content="Install or update" Click="InstallTosu_Click" Padding="12,5" VerticalAlignment="Center" AutomationProperties.Name="Install or update managed tosu"/><ProgressBar x:Name="TosuProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,10,0,7" Visibility="Collapsed" AutomationProperties.Name="Managed tosu installation progress"/><TextBlock x:Name="TosuActionStatus" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Grid></Border>
                        <TextBlock Text="tosu connection becomes ready automatically after osu! starts. You do not need to keep a separate setup window open." Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CaptureStep" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CaptureHeading" Text="Replay capture" Style="{StaticResource SetupTitle}"/>
                        <TextBlock Text="Replay-frame capture enables hit timing, movement graphs, map pressure, and Replay Analyzer." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><StackPanel><CheckBox x:Name="CaptureEnabled" Content="Enable detailed replay capture" FontWeight="SemiBold" Checked="CaptureEnabled_Changed" Unchecked="CaptureEnabled_Changed" AutomationProperties.Name="Enable detailed replay capture"/><TextBlock Text="Capture stays on this computer and is attached to your local play records." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="18,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource SetupCard}" Background="{DynamicResource Brush.CardSelectedBackground}"><StackPanel><TextBlock Text="Compatibility" FontWeight="SemiBold"/><TextBlock x:Name="CaptureDetail" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
                        <TextBlock x:Name="CaptureRestartNote" Text="If a play is active, capture changes apply after that play finishes." Foreground="{DynamicResource Brush.Warning}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="OptionalStep" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="OptionalHeading" Text="Optional integrations" Style="{StaticResource SetupTitle}"/>
                        <TextBlock Text="None of these options are required for play tracking." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="OpenTabletDriver auto-launch" TextWrapping="Wrap" Margin="0,0,12,0" FontWeight="SemiBold"/><CheckBox x:Name="AutoLaunchOtd" Grid.Column="1" Content="Enable" Checked="AutoLaunchOtd_Changed" Unchecked="AutoLaunchOtd_Changed" AutomationProperties.Name="Enable OpenTabletDriver auto-launch"/></Grid><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OtdPath" Tag="OpenTabletDriver.UX.Wpf.exe" AutomationProperties.Name="OpenTabletDriver executable path"/><Button Grid.Column="1" Content="Browse" Click="BrowseOtd_Click" Margin="8,0,0,0" Padding="9,4" AutomationProperties.Name="Browse for OpenTabletDriver"/><Button Grid.Column="2" Content="Detect" Click="DetectOtd_Click" Margin="8,0,0,0" Padding="9,4" AutomationProperties.Name="Detect OpenTabletDriver"/></Grid><TextBlock x:Name="OtdStatus" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Replay skin" FontWeight="SemiBold"/><TextBlock Text="Use the default, or choose an imported replay skin." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,4,12,0"/></StackPanel><Button Grid.Column="1" Content="Skin library" Click="Skin_Click" Padding="11,4" VerticalAlignment="Center" AutomationProperties.Name="Open replay skin library"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Windows startup" FontWeight="SemiBold"/><TextBlock Text="Start Kumori automatically after sign-in." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,4,12,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><CheckBox x:Name="RunAtLogin" Content="Enable" AutomationProperties.Name="Start Kumori with Windows"/><CheckBox x:Name="StartMinimized" Content="Start minimized to tray" IsEnabled="{Binding IsChecked, ElementName=RunAtLogin}" Margin="0,5,0,0" AutomationProperties.Name="Start Kumori minimized to the system tray"/></StackPanel></Grid></Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ReadyStep" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReadyHeading" Text="Ready to play" Style="{StaticResource SetupTitle}"/>
                        <TextBlock x:Name="ReadyIntro" Text="Review your choices. You can change everything later under Settings &amp; tools." Style="{StaticResource SetupHint}"/>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Play tracking" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="SummaryTracking" Grid.Column="1" Style="{StaticResource StatusValue}"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Minimum saved play" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="SummaryMinimumDuration" Grid.Column="1" Style="{StaticResource StatusValue}"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Replay capture" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="SummaryCapture" Grid.Column="1" Style="{StaticResource StatusValue}"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="OpenTabletDriver auto-launch" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="SummaryOtd" Grid.Column="1" Style="{StaticResource StatusValue}"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Start with Windows" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="SummaryStartup" Grid.Column="1" Style="{StaticResource StatusValue}"/></Grid></Border>
                        <Border Style="{StaticResource SetupCard}" Background="{DynamicResource Brush.CardSelectedBackground}"><StackPanel><TextBlock x:Name="ReadyPrimaryMessage" Text="Play any map to record your first result." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ReadySecondaryMessage" Text="Kumori will remain available from the system tray when the main window is closed." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.SubtleBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Grid.ColumnSpan="2" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.HelpText="Setup status" AutomationProperties.LiveSetting="Assertive"/>
                <Button x:Name="CancelButton" Grid.Row="1" Content="Cancel" Click="Cancel_Click" Padding="13,5" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Cancel setup changes"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Back" Click="Back_Click" Padding="14,5" Margin="0,0,8,0" IsEnabled="False" AutomationProperties.Name="Previous setup step"/><Button x:Name="NextButton" Content="Continue" Click="Next_Click" Style="{StaticResource Button.Primary}" Padding="14,5" AutomationProperties.Name="Continue to next setup step"/><Button x:Name="FinishButton" Content="Finish setup" Click="Done_Click" Style="{StaticResource Button.Primary}" Padding="14,5" Visibility="Collapsed" AutomationProperties.Name="Finish setup"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
