<Window x:Class="Kumori.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kumori Setup"
        Width="602" Height="540"
        MinWidth="602" MinHeight="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.AppBackground}"
        BorderBrush="{StaticResource Brush.StrongBorder}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Background="{StaticResource Brush.AppBackground}"
            Padding="24,20,24,14">
    <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="First time setup" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Set up the pieces Kumori needs for osu! stats tracking."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{StaticResource Brush.CardBackground}"
                        BorderBrush="{StaticResource Brush.SubtleBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,5"
                        VerticalAlignment="Top">
                    <TextBlock Text="lazer only" Style="{StaticResource Text.LabelUpper}" Foreground="{StaticResource Brush.Cyan}" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.SubtleBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="tosu stats tracking" Style="{StaticResource Text.RowTitle}" />
                                <TextBlock Text="Kumori uses vanilla tosu only for play metadata. It launches automatically when osu! starts."
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,18,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="tosu setup" Click="Tosu_Click" MinWidth="112" Padding="8,4" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.SubtleBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OpenTabletDriver auto-launch" Style="{StaticResource Text.RowTitle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          x:Name="AutoLaunchOtd"
                                          Content="Enable"
                                          Checked="AutoLaunchOtd_Changed"
                                          Unchecked="AutoLaunchOtd_Changed"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OtdPath" Tag="OpenTabletDriver.UX.Wpf.exe" />
                                <Button Grid.Column="1" Content="Browse" Click="BrowseOtd_Click" Margin="8,0,0,0" MinWidth="68" Padding="8,4" />
                                <Button Grid.Column="2" Content="Detect" Click="DetectOtd_Click" Margin="8,0,0,0" MinWidth="68" Padding="8,4" />
                            </Grid>
                            <TextBlock x:Name="OtdStatus"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.SubtleBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Replay review" Style="{StaticResource Text.RowTitle}" />
                                <TextBlock Text="Choose a skin now, or keep the default viewer setup."
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,18,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Skin library" Click="Skin_Click" MinWidth="92" Padding="8,4" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.SubtleBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows startup" Style="{StaticResource Text.RowTitle}" />
                                <TextBlock Text="Start Kumori automatically after sign-in."
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,18,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="RunAtLogin" Content="Enable" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Finish" Click="Done_Click" Style="{StaticResource Button.Primary}" MinWidth="78" Padding="8,4" />
                </StackPanel>
            </Grid>
    </Grid>
    </Border>
</Window>
