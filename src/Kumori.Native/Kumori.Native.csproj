<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The direct System.Drawing.Common security floor is intentional. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kumori.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Security floor for the legacy System.Drawing.Common dependency pulled by
         Microsoft.Toolkit.Uwp.Notifications. It is intentionally retained. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <ProjectReference Include="..\Kumori.Core\Kumori.Core.csproj" />
    <ProjectReference Include="..\Kumori.Storage\Kumori.Storage.csproj" />
    <ProjectReference Include="..\Kumori.Tracking\Kumori.Tracking.csproj" />
  </ItemGroup>
</Project>
